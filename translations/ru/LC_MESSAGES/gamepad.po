#: plugin.toml
msgctxt "plugin.toml"
msgid "Gamepad"
msgstr "Геймпад"

#: plugin.toml
msgctxt "plugin.toml"
msgid ""
"Provides support for using gamepads as input devices: pan, zoom and switch "
"panes, tabs and series items with a game controller."
msgstr ""
"Позволяет использовать геймпады как устройства ввода: сдвигать и "
"масштабировать вид, переключать окна просмотра, вкладки и элементы серии с "
"помощью игрового контроллера."

#. Translators: the horizontal (X) axis of the left stick of a game
#. controller; keep the letter X
#: src/config.rs:136
msgid "Left Stick X"
msgstr "Левый стик X"

#. Translators: the vertical (Y) axis of the left stick
#: src/config.rs:138
msgid "Left Stick Y"
msgstr "Левый стик Y"

#. Translators: the horizontal (X) axis of the right stick
#: src/config.rs:140
msgid "Right Stick X"
msgstr "Правый стик X"

#. Translators: the vertical (Y) axis of the right stick
#: src/config.rs:142
msgid "Right Stick Y"
msgstr "Правый стик Y"

#. Translators: the analog trigger under the left shoulder (LT, L2)
#: src/config.rs:144
msgid "Left Trigger"
msgstr "Левый триггер"

#. Translators: the analog trigger under the right shoulder (RT, R2)
#: src/config.rs:146
msgid "Right Trigger"
msgstr "Правый триггер"

#. Translators: D-Pad is the directional pad, the cross of four
#. buttons on the left of a game controller
#: src/config.rs:149
msgid "D-Pad Left"
msgstr "Крестовина влево"

#: src/config.rs:150
msgid "D-Pad Right"
msgstr "Крестовина вправо"

#: src/config.rs:151
msgid "D-Pad Up"
msgstr "Крестовина вверх"

#: src/config.rs:152
msgid "D-Pad Down"
msgstr "Крестовина вниз"

#. Translators: the four face buttons are named by their position:
#. the bottom one (A on Xbox, Cross on PlayStation, B on Nintendo)
#: src/config.rs:155
msgid "South Button"
msgstr "Нижняя кнопка"

#. Translators: the right face button (B on Xbox, Circle on PlayStation)
#: src/config.rs:157
msgid "East Button"
msgstr "Правая кнопка"

#. Translators: the top face button (Y on Xbox, Triangle on PlayStation)
#: src/config.rs:159
msgid "North Button"
msgstr "Верхняя кнопка"

#. Translators: the left face button (X on Xbox, Square on PlayStation)
#: src/config.rs:161
msgid "West Button"
msgstr "Левая кнопка"

#. Translators: the left shoulder button, or bumper (LB, L1)
#: src/config.rs:163
msgid "Left Shoulder"
msgstr "Левый бампер"

#. Translators: the right shoulder button, or bumper (RB, R1)
#: src/config.rs:165
msgid "Right Shoulder"
msgstr "Правый бампер"

#. Translators: pressing the left stick down like a button (LS, L3)
#: src/config.rs:167
msgid "Left Stick Click"
msgstr "Нажатие левого стика"

#. Translators: pressing the right stick down like a button (RS, R3)
#: src/config.rs:169
msgid "Right Stick Click"
msgstr "Нажатие правого стика"

#. Translators: a control that does nothing
#: src/config.rs:293
msgid "Unassigned"
msgstr "Не назначено"

#. Translators: an action of a game controller; to pan is to move
#. the view of the slide sideways
#: src/config.rs:296
msgid "Pan Horizontally"
msgstr "Сдвиг по горизонтали"

#: src/config.rs:297
msgid "Pan Vertically"
msgstr "Сдвиг по вертикали"

#. Translators: for a stick or trigger: pushing it up or to the
#. right zooms in, the other way zooms out
#: src/config.rs:300
msgid "Zoom (Up / Right Zooms In)"
msgstr "Масштаб (вверх / вправо — приблизить)"

#: src/config.rs:301
msgid "Zoom In"
msgstr "Приблизить"

#: src/config.rs:302
msgid "Zoom Out"
msgstr "Отдалить"

#. Translators: moves the mouse pointer of the operating system
#: src/config.rs:304
msgid "Move Pointer Horizontally"
msgstr "Перемещение указателя по горизонтали"

#: src/config.rs:305
msgid "Move Pointer Vertically"
msgstr "Перемещение указателя по вертикали"

#. Translators: a pane is one of the views side by side in eov
#: src/config.rs:307
msgid "Previous Pane"
msgstr "Предыдущее окно просмотра"

#: src/config.rs:308
msgid "Next Pane"
msgstr "Следующее окно просмотра"

#: src/config.rs:309
msgid "Previous Tab"
msgstr "Предыдущая вкладка"

#: src/config.rs:310
msgid "Next Tab"
msgstr "Следующая вкладка"

#. Translators: the series bar lists the slides of a series
#: src/config.rs:312
msgid "Toggle Series Bar"
msgstr "Показать/скрыть панель серии"

#: src/config.rs:313
msgid "Previous Series Item"
msgstr "Предыдущий элемент серии"

#: src/config.rs:314
msgid "Next Series Item"
msgstr "Следующий элемент серии"

#: src/config.rs:315
msgid "Open Selected Series Item"
msgstr "Открыть выбранный элемент серии"

#. Translators: fits the whole slide into the view
#: src/config.rs:317
msgid "Fit View"
msgstr "Вписать препарат"

#. Translators: this window is the gamepad settings window
#: src/config.rs:319
msgid "Show / Hide This Window"
msgstr "Показать / скрыть это окно"

#. Translators: turns gamepad input back on, or pauses it
#: src/config.rs:321
msgid "Enable / Pause"
msgstr "Включить / приостановить"

#. Translators: a dead zone is how far a stick may move before it
#. counts as input (it hides stick drift); shown in a narrow column
#: src/config.rs:459
msgid "Left Dead Zone"
msgstr "Левая мёртв. зона"

#: src/config.rs:460
msgid "Right Dead Zone"
msgstr "Правая мёртв. зона"

#: src/config.rs:461
msgid "Trigger Dead Zone"
msgstr "Порог триггеров"

#: src/config.rs:462
msgid "Pan Speed"
msgstr "Скорость сдвига"

#: src/config.rs:463
msgid "Zoom Speed"
msgstr "Скорость масштаба"

#. Translators: how input grows with the deflection of a stick: a
#. higher curve gives finer control near the centre
#: src/config.rs:466
msgid "Response Curve"
msgstr "Кривая отклика"

#. Translators: the speed of the mouse pointer of the operating system
#: src/config.rs:468
msgid "Pointer Speed"
msgstr "Скорость указателя"

#: src/config.rs:684
msgid "not a profile object"
msgstr "не является объектом профиля"

#. Translators: {} is the value of the "version" field of a profile
#: src/config.rs:694
msgid "ignoring the version {}"
msgstr "версия {} игнорируется"

#. Translators: {key} is a field of a profile file, such as
#. 'pan_sensitivity'; {value} is what the field holds
#: src/config.rs:712
msgid "ignoring '{key}': {value} is not a number"
msgstr "«{key}» игнорируется: {value} не является числом"

#. Translators: 'mappings' is a field of a profile file: keep the name
#: src/config.rs:730
msgid "ignoring 'mappings': not an object"
msgstr "«mappings» игнорируется: это не объект"

#: src/config.rs:745
msgid "the file is not a gamepad profile"
msgstr "файл не является профилем геймпада"

#: src/config.rs:794
msgid "the stored gamepad settings are not an object"
msgstr "сохранённые настройки геймпада не являются объектом"

#. Translators: {key} is a stored setting, such as 'enabled'; {error}
#. says why it cannot be read
#: src/config.rs:809
msgid "ignoring the stored '{key}': {error}"
msgstr "сохранённый параметр «{key}» игнорируется: {error}"

#. Translators: {} is a problem with the current settings (not a profile)
#: src/config.rs:840
msgid "settings: {}"
msgstr "настройки: {}"

#: src/config.rs:843
msgid "ignoring the stored settings: {}"
msgstr "сохранённые настройки игнорируются: {}"

#: src/config.rs:854
msgid "ignoring the profile with the name {}"
msgstr "профиль с именем {} игнорируется"

#: src/config.rs:859
msgid "ignoring the profile {name}: at most {n} profile is kept"
msgid_plural "ignoring the profile {name}: at most {n} profiles are kept"
msgstr[0] "профиль {name} игнорируется: хранится не более {n} профиля"
msgstr[1] "профиль {name} игнорируется: хранится не более {n} профилей"
msgstr[2] "профиль {name} игнорируется: хранится не более {n} профилей"

#. Translators: {name} is the name of a profile,
#. {problem} what is wrong with it
#: src/config.rs:873
msgid "{name}: {problem}"
msgstr "{name}: {problem}"

#. Translators: the name of a profile, then why it cannot be read
#: src/config.rs:881
msgid "ignoring the profile {}: {}"
msgstr "профиль {} игнорируется: {}"

#: src/config.rs:983
msgid "Enter a name for the profile."
msgstr "Введите имя профиля."

#: src/config.rs:986
msgid "Profile names are limited to {n} character."
msgid_plural "Profile names are limited to {n} characters."
msgstr[0] "Имя профиля не может быть длиннее {n} символа."
msgstr[1] "Имя профиля не может быть длиннее {n} символов."
msgstr[2] "Имя профиля не может быть длиннее {n} символов."

#: src/config.rs:991
msgid "Profile names cannot contain control characters."
msgstr "Имя профиля не может содержать управляющие символы."

#. Translators: the name given to a profile whose name would be empty
#: src/config.rs:1003
msgctxt "Profile name"
msgid "Profile"
msgstr "Профиль"

#. Translators: shown after the name of a controller; {level} is the
#. charge of its battery in percent
#: src/engine.rs:74
msgid "battery {level}%"
msgstr "батарея {level}%"

#. Translators: shown after the name of a controller; {level} is the
#. charge of its battery in percent
#: src/engine.rs:77
msgid "charging, {level}%"
msgstr "заряжается, {level}%"

#. Translators: shown after the name of a controller: its battery is full
#: src/engine.rs:79
msgid "charged"
msgstr "заряжен"

#. Translators: {} is a folder of the system, such as /dev/input
#: src/environment.rs:88
msgid "{} is not available, so no controller can be opened."
msgstr "Папка {} недоступна, поэтому невозможно открыть ни один контроллер."

#. Translators: udev is the Linux device manager and uaccess the name
#. of its tag: keep both
#: src/environment.rs:112
msgid ""
"A game controller is connected, but eov is not allowed to read it. udev "
"normally gives the logged-in user access to controllers (the uaccess tag); "
"if yours is not recognised as a joystick, add a udev rule that tags it with "
"uaccess, then reconnect it."
msgstr ""
"Игровой контроллер подключён, но у eov нет прав на чтение с него. Обычно "
"udev предоставляет вошедшему в систему пользователю доступ к контроллерам "
"(тег uaccess); если ваш контроллер не распознаётся как джойстик, добавьте "
"правило udev, назначающее ему тег uaccess, и переподключите его."

#. Translators: {command} is a command to type and {option} one of
#. its options: they stay as they are
#: src/environment.rs:124
msgid ""
"eov runs as a Flatpak without access to input devices. Allow it by running "
"{command} (Flatpak 1.15.6 or newer; older versions need {option}), then "
"restart eov."
msgstr ""
"eov работает как Flatpak без доступа к устройствам ввода. Разрешите доступ "
"командой {command} (Flatpak 1.15.6 или новее; для более старых версий нужен "
"параметр {option}), затем перезапустите eov."

#. Translators: the type of file in the file dialog
#: src/plugin.rs:91
msgid "Gamepad profile"
msgstr "Профиль геймпада"

#. Translators: the tooltip of the toolbar button, and the title of
#. the gamepad settings window
#: src/plugin.rs:100 src/ui.rs:26
msgid "Gamepad"
msgstr "Геймпад"

#: src/plugin.rs:108
msgid "the path has no file name"
msgstr "в пути нет имени файла"

#: src/plugin.rs:123
msgid "the file is too large to be a gamepad profile"
msgstr "файл слишком велик для профиля геймпада"

#: src/plugin.rs:212
msgid "Cannot open the gamepad window"
msgstr "Не удаётся открыть окно геймпада"

#. Translators: {} is the name of a profile
#: src/plugin.rs:272
msgid "The profile “{}” no longer exists."
msgstr "Профиля «{}» больше не существует."

#. Translators: the name of a new profile when none was typed
#: src/plugin.rs:280
msgctxt "Profile name"
msgid "Untitled"
msgstr "Без имени"

#. Translators: {} is the name of a profile
#: src/plugin.rs:310
msgid ""
"A profile named “{}” already exists. Replace it with the default settings?"
msgstr ""
"Профиль с именем «{}» уже существует. Заменить его настройками по умолчанию?"

#. Translators: {} is the name of a profile
#: src/plugin.rs:316
msgid ""
"A profile named “{}” already exists. Replace it with the current settings?"
msgstr ""
"Профиль с именем «{}» уже существует. Заменить его текущими настройками?"

#: src/plugin.rs:321
msgid "Replace profile?"
msgstr "Заменить профиль?"

#. Translators: a button: replaces the profile
#: src/plugin.rs:324
msgid "Replace"
msgstr "Заменить"

#: src/plugin.rs:325 src/plugin.rs:370
msgid "Cancel"
msgstr "Отмена"

#: src/plugin.rs:338
msgid "You already have {n} profile. Delete one to save another."
msgid_plural "You already have {n} profiles. Delete one to save another."
msgstr[0] "У вас уже {n} профиль. Удалите один, чтобы сохранить другой."
msgstr[1] "У вас уже {n} профиля. Удалите один, чтобы сохранить другой."
msgstr[2] "У вас уже {n} профилей. Удалите один, чтобы сохранить другой."

#: src/plugin.rs:358
msgid "Choose a saved profile to delete."
msgstr "Выберите сохранённый профиль для удаления."

#: src/plugin.rs:362
msgid "Delete profile?"
msgstr "Удалить профиль?"

#. Translators: {} is the name of a profile
#: src/plugin.rs:365
msgid "Delete the profile “{}”? This cannot be undone."
msgstr "Удалить профиль «{}»? Это действие нельзя отменить."

#. Translators: a button: deletes the profile
#: src/plugin.rs:369
msgid "Delete"
msgstr "Удалить"

#: src/plugin.rs:384
msgid "Import a gamepad profile"
msgstr "Импорт профиля геймпада"

#. Translators: the name of an exported profile when none is selected
#: src/plugin.rs:401
msgctxt "Profile name"
msgid "Gamepad profile"
msgstr "Профиль геймпада"

#: src/plugin.rs:407
msgid "Export the gamepad profile"
msgstr "Экспорт профиля геймпада"

#. Translators: {} is the path of a file
#: src/plugin.rs:465
msgid "Cannot import {}"
msgstr "Не удаётся импортировать {}"

#. Translators: the name of an imported profile when its file name
#. cannot be used
#: src/plugin.rs:478
msgctxt "Profile name"
msgid "Imported"
msgstr "Импортированный"

#. Translators: {} is the name of a profile
#: src/plugin.rs:496
msgid "Imported the profile “{}”"
msgstr "Профиль «{}» импортирован"

#: src/plugin.rs:502
msgid "You already have {n} profile. Delete one to import another."
msgid_plural "You already have {n} profiles. Delete one to import another."
msgstr[0] "У вас уже {n} профиль. Удалите один, чтобы импортировать другой."
msgstr[1] "У вас уже {n} профиля. Удалите один, чтобы импортировать другой."
msgstr[2] "У вас уже {n} профилей. Удалите один, чтобы импортировать другой."

#: src/plugin.rs:527
msgid "Cannot export the profile"
msgstr "Не удаётся экспортировать профиль"

#. Translators: {name} is the name of a profile, {path} a file
#: src/plugin.rs:536
msgid "Exported “{name}” to {path}"
