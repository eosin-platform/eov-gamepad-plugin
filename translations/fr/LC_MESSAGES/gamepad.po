#: plugin.toml
msgctxt "plugin.toml"
msgid "Gamepad"
msgstr "Manette de jeu"

#: plugin.toml
msgctxt "plugin.toml"
msgid ""
"Provides support for using gamepads as input devices: pan, zoom and switch "
"panes, tabs and series items with a game controller."
msgstr ""
"Permet d'utiliser des manettes de jeu comme périphériques d'entrée : "
"déplacer la vue, zoomer et passer d'un volet, d'un onglet ou d'un élément de "
"série à l'autre avec une manette."

#. Translators: the horizontal (X) axis of the left stick of a game
#. controller; keep the letter X
#: src/config.rs:136
msgid "Left Stick X"
msgstr "Stick gauche X"

#. Translators: the vertical (Y) axis of the left stick
#: src/config.rs:138
msgid "Left Stick Y"
msgstr "Stick gauche Y"

#. Translators: the horizontal (X) axis of the right stick
#: src/config.rs:140
msgid "Right Stick X"
msgstr "Stick droit X"

#. Translators: the vertical (Y) axis of the right stick
#: src/config.rs:142
msgid "Right Stick Y"
msgstr "Stick droit Y"

#. Translators: the analog trigger under the left shoulder (LT, L2)
#: src/config.rs:144
msgid "Left Trigger"
msgstr "Gâchette gauche"

#. Translators: the analog trigger under the right shoulder (RT, R2)
#: src/config.rs:146
msgid "Right Trigger"
msgstr "Gâchette droite"

#. Translators: D-Pad is the directional pad, the cross of four
#. buttons on the left of a game controller
#: src/config.rs:149
msgid "D-Pad Left"
msgstr "Croix : gauche"

#: src/config.rs:150
msgid "D-Pad Right"
msgstr "Croix : droite"

#: src/config.rs:151
msgid "D-Pad Up"
msgstr "Croix : haut"

#: src/config.rs:152
msgid "D-Pad Down"
msgstr "Croix : bas"

#. Translators: the four face buttons are named by their position:
#. the bottom one (A on Xbox, Cross on PlayStation, B on Nintendo)
#: src/config.rs:155
msgid "South Button"
msgstr "Bouton sud"

#. Translators: the right face button (B on Xbox, Circle on PlayStation)
#: src/config.rs:157
msgid "East Button"
msgstr "Bouton est"

#. Translators: the top face button (Y on Xbox, Triangle on PlayStation)
#: src/config.rs:159
msgid "North Button"
msgstr "Bouton nord"

#. Translators: the left face button (X on Xbox, Square on PlayStation)
#: src/config.rs:161
msgid "West Button"
msgstr "Bouton ouest"

#. Translators: the left shoulder button, or bumper (LB, L1)
#: src/config.rs:163
msgid "Left Shoulder"
msgstr "Bouton supérieur gauche"

#. Translators: the right shoulder button, or bumper (RB, R1)
#: src/config.rs:165
msgid "Right Shoulder"
msgstr "Bouton supérieur droit"

#. Translators: pressing the left stick down like a button (LS, L3)
#: src/config.rs:167
msgid "Left Stick Click"
msgstr "Clic du stick gauche"

#. Translators: pressing the right stick down like a button (RS, R3)
#: src/config.rs:169
msgid "Right Stick Click"
msgstr "Clic du stick droit"

#. Translators: a control that does nothing
#: src/config.rs:293
msgid "Unassigned"
msgstr "Non affecté"

#. Translators: an action of a game controller; to pan is to move
#. the view of the slide sideways
#: src/config.rs:296
msgid "Pan Horizontally"
msgstr "Déplacer la vue horizontalement"

#: src/config.rs:297
msgid "Pan Vertically"
msgstr "Déplacer la vue verticalement"

#. Translators: for a stick or trigger: pushing it up or to the
#. right zooms in, the other way zooms out
#: src/config.rs:300
msgid "Zoom (Up / Right Zooms In)"
msgstr "Zoom (haut/droite : zoom avant)"

#: src/config.rs:301
msgid "Zoom In"
msgstr "Zoom avant"

#: src/config.rs:302
msgid "Zoom Out"
msgstr "Zoom arrière"

#. Translators: moves the mouse pointer of the operating system
#: src/config.rs:304
msgid "Move Pointer Horizontally"
msgstr "Déplacer le pointeur horizontalement"

#: src/config.rs:305
msgid "Move Pointer Vertically"
msgstr "Déplacer le pointeur verticalement"

#. Translators: a pane is one of the views side by side in eov
#: src/config.rs:307
msgid "Previous Pane"
msgstr "Volet précédent"

#: src/config.rs:308
msgid "Next Pane"
msgstr "Volet suivant"

#: src/config.rs:309
msgid "Previous Tab"
msgstr "Onglet précédent"

#: src/config.rs:310
msgid "Next Tab"
msgstr "Onglet suivant"

#. Translators: the series bar lists the slides of a series
#: src/config.rs:312
msgid "Toggle Series Bar"
msgstr "Afficher/masquer la barre de série"

#: src/config.rs:313
msgid "Previous Series Item"
msgstr "Élément de série précédent"

#: src/config.rs:314
msgid "Next Series Item"
msgstr "Élément de série suivant"

#: src/config.rs:315
msgid "Open Selected Series Item"
msgstr "Ouvrir l'élément de série sélectionné"

#. Translators: fits the whole slide into the view
#: src/config.rs:317
msgid "Fit View"
msgstr "Ajuster la vue"

#. Translators: this window is the gamepad settings window
#: src/config.rs:319
msgid "Show / Hide This Window"
msgstr "Afficher/masquer cette fenêtre"

#. Translators: turns gamepad input back on, or pauses it
#: src/config.rs:321
msgid "Enable / Pause"
msgstr "Activer/mettre en pause"

#. Translators: a dead zone is how far a stick may move before it
#. counts as input (it hides stick drift); shown in a narrow column
#: src/config.rs:459
msgid "Left Dead Zone"
msgstr "Zone morte gauche"

#: src/config.rs:460
msgid "Right Dead Zone"
msgstr "Zone morte droite"

#: src/config.rs:461
msgid "Trigger Dead Zone"
msgstr "Zone morte gâchettes"

#: src/config.rs:462
msgid "Pan Speed"
msgstr "Vitesse de défilement"

#: src/config.rs:463
msgid "Zoom Speed"
msgstr "Vitesse du zoom"

#. Translators: how input grows with the deflection of a stick: a
#. higher curve gives finer control near the centre
#: src/config.rs:466
msgid "Response Curve"
msgstr "Courbe de réponse"

#. Translators: the speed of the mouse pointer of the operating system
#: src/config.rs:468
msgid "Pointer Speed"
msgstr "Vitesse du pointeur"

