#: plugin.toml
msgctxt "plugin.toml"
msgid "Gamepad"
msgstr "Controle de jogo"

#: plugin.toml
msgctxt "plugin.toml"
msgid ""
"Provides support for using gamepads as input devices: pan, zoom and switch "
"panes, tabs and series items with a game controller."
msgstr ""
"Permite usar controles de jogo como dispositivos de entrada: deslocar a "
"visualização, aplicar zoom e alternar entre painéis, abas e itens da série "
"com um controle de jogo."

#. Translators: the horizontal (X) axis of the left stick of a game
#. controller; keep the letter X
#: src/config.rs:136
msgid "Left Stick X"
msgstr "Analógico esquerdo X"

#. Translators: the vertical (Y) axis of the left stick
#: src/config.rs:138
msgid "Left Stick Y"
msgstr "Analógico esquerdo Y"

#. Translators: the horizontal (X) axis of the right stick
#: src/config.rs:140
msgid "Right Stick X"
msgstr "Analógico direito X"

#. Translators: the vertical (Y) axis of the right stick
#: src/config.rs:142
msgid "Right Stick Y"
msgstr "Analógico direito Y"

#. Translators: the analog trigger under the left shoulder (LT, L2)
#: src/config.rs:144
msgid "Left Trigger"
msgstr "Gatilho esquerdo"

#. Translators: the analog trigger under the right shoulder (RT, R2)
#: src/config.rs:146
msgid "Right Trigger"
msgstr "Gatilho direito"

#. Translators: D-Pad is the directional pad, the cross of four
#. buttons on the left of a game controller
#: src/config.rs:149
msgid "D-Pad Left"
msgstr "Direcional: esquerda"

#: src/config.rs:150
msgid "D-Pad Right"
msgstr "Direcional: direita"

#: src/config.rs:151
msgid "D-Pad Up"
msgstr "Direcional: cima"

#: src/config.rs:152
msgid "D-Pad Down"
msgstr "Direcional: baixo"

#. Translators: the four face buttons are named by their position:
#. the bottom one (A on Xbox, Cross on PlayStation, B on Nintendo)
#: src/config.rs:155
msgid "South Button"
msgstr "Botão sul"

#. Translators: the right face button (B on Xbox, Circle on PlayStation)
#: src/config.rs:157
msgid "East Button"
msgstr "Botão leste"

#. Translators: the top face button (Y on Xbox, Triangle on PlayStation)
#: src/config.rs:159
msgid "North Button"
msgstr "Botão norte"

#. Translators: the left face button (X on Xbox, Square on PlayStation)
#: src/config.rs:161
msgid "West Button"
msgstr "Botão oeste"

#. Translators: the left shoulder button, or bumper (LB, L1)
#: src/config.rs:163
msgid "Left Shoulder"
msgstr "Botão de ombro esquerdo"

#. Translators: the right shoulder button, or bumper (RB, R1)
#: src/config.rs:165
msgid "Right Shoulder"
msgstr "Botão de ombro direito"

#. Translators: pressing the left stick down like a button (LS, L3)
#: src/config.rs:167
msgid "Left Stick Click"
msgstr "Clique do analógico esquerdo"

#. Translators: pressing the right stick down like a button (RS, R3)
#: src/config.rs:169
msgid "Right Stick Click"
msgstr "Clique do analógico direito"

#. Translators: a control that does nothing
#: src/config.rs:293
msgid "Unassigned"
msgstr "Não atribuído"

#. Translators: an action of a game controller; to pan is to move
#. the view of the slide sideways
#: src/config.rs:296
msgid "Pan Horizontally"
msgstr "Deslocar horizontalmente"

#: src/config.rs:297
msgid "Pan Vertically"
msgstr "Deslocar verticalmente"

#. Translators: for a stick or trigger: pushing it up or to the
#. right zooms in, the other way zooms out
#: src/config.rs:300
msgid "Zoom (Up / Right Zooms In)"
msgstr "Zoom (cima / direita aumenta)"

#: src/config.rs:301
msgid "Zoom In"
msgstr "Aumentar zoom"

#: src/config.rs:302
msgid "Zoom Out"
msgstr "Reduzir zoom"

#. Translators: moves the mouse pointer of the operating system
#: src/config.rs:304
msgid "Move Pointer Horizontally"
msgstr "Mover ponteiro horizontalmente"

#: src/config.rs:305
msgid "Move Pointer Vertically"
msgstr "Mover ponteiro verticalmente"

#. Translators: a pane is one of the views side by side in eov
#: src/config.rs:307
msgid "Previous Pane"
msgstr "Painel anterior"

#: src/config.rs:308
msgid "Next Pane"
msgstr "Próximo painel"

#: src/config.rs:309
msgid "Previous Tab"
msgstr "Aba anterior"

#: src/config.rs:310
msgid "Next Tab"
msgstr "Próxima aba"

#. Translators: the series bar lists the slides of a series
#: src/config.rs:312
msgid "Toggle Series Bar"
msgstr "Mostrar ou ocultar barra de séries"

#: src/config.rs:313
msgid "Previous Series Item"
msgstr "Item anterior da série"

#: src/config.rs:314
msgid "Next Series Item"
msgstr "Próximo item da série"

#: src/config.rs:315
msgid "Open Selected Series Item"
msgstr "Abrir item selecionado da série"

#. Translators: fits the whole slide into the view
#: src/config.rs:317
msgid "Fit View"
msgstr "Ajustar à lâmina"

#. Translators: this window is the gamepad settings window
#: src/config.rs:319
msgid "Show / Hide This Window"
msgstr "Mostrar / ocultar esta janela"

#. Translators: turns gamepad input back on, or pauses it
#: src/config.rs:321
msgid "Enable / Pause"
msgstr "Ativar / pausar"

#. Translators: a dead zone is how far a stick may move before it
#. counts as input (it hides stick drift); shown in a narrow column
#: src/config.rs:459
msgid "Left Dead Zone"
msgstr "Zona morta esq."

#: src/config.rs:460
msgid "Right Dead Zone"
msgstr "Zona morta dir."

#: src/config.rs:461
msgid "Trigger Dead Zone"
msgstr "Zona morta gatilhos"

#: src/config.rs:462
msgid "Pan Speed"
msgstr "Vel. deslocamento"

#: src/config.rs:463
msgid "Zoom Speed"
msgstr "Vel. zoom"

#. Translators: how input grows with the deflection of a stick: a
#. higher curve gives finer control near the centre
#: src/config.rs:466
msgid "Response Curve"
msgstr "Curva de resposta"

#. Translators: the speed of the mouse pointer of the operating system
#: src/config.rs:468
msgid "Pointer Speed"
msgstr "Vel. ponteiro"

