#: plugin.toml
msgctxt "plugin.toml"
msgid "Gamepad"
msgstr "Spilcontroller"

#: plugin.toml
msgctxt "plugin.toml"
msgid ""
"Provides support for using gamepads as input devices: pan, zoom and switch "
"panes, tabs and series items with a game controller."
msgstr ""
"Gør det muligt at bruge spilcontrollere som inputenheder: panorere, zoome og "
"skifte mellem ruder, faner og elementer i serien med en spilcontroller."

#. Translators: the horizontal (X) axis of the left stick of a game
#. controller; keep the letter X
#: src/config.rs:136
msgid "Left Stick X"
msgstr "Venstre styrepind X"

#. Translators: the vertical (Y) axis of the left stick
#: src/config.rs:138
msgid "Left Stick Y"
msgstr "Venstre styrepind Y"

#. Translators: the horizontal (X) axis of the right stick
#: src/config.rs:140
msgid "Right Stick X"
msgstr "Højre styrepind X"

#. Translators: the vertical (Y) axis of the right stick
#: src/config.rs:142
msgid "Right Stick Y"
msgstr "Højre styrepind Y"

#. Translators: the analog trigger under the left shoulder (LT, L2)
#: src/config.rs:144
msgid "Left Trigger"
msgstr "Venstre udløser"

#. Translators: the analog trigger under the right shoulder (RT, R2)
#: src/config.rs:146
msgid "Right Trigger"
msgstr "Højre udløser"

#. Translators: D-Pad is the directional pad, the cross of four
#. buttons on the left of a game controller
#: src/config.rs:149
msgid "D-Pad Left"
msgstr "Retningsknap venstre"

#: src/config.rs:150
msgid "D-Pad Right"
msgstr "Retningsknap højre"

#: src/config.rs:151
msgid "D-Pad Up"
msgstr "Retningsknap op"

#: src/config.rs:152
msgid "D-Pad Down"
msgstr "Retningsknap ned"

#. Translators: the four face buttons are named by their position:
#. the bottom one (A on Xbox, Cross on PlayStation, B on Nintendo)
#: src/config.rs:155
msgid "South Button"
msgstr "Nederste frontknap"

#. Translators: the right face button (B on Xbox, Circle on PlayStation)
#: src/config.rs:157
msgid "East Button"
msgstr "Højre frontknap"

#. Translators: the top face button (Y on Xbox, Triangle on PlayStation)
#: src/config.rs:159
msgid "North Button"
msgstr "Øverste frontknap"

#. Translators: the left face button (X on Xbox, Square on PlayStation)
#: src/config.rs:161
msgid "West Button"
msgstr "Venstre frontknap"

#. Translators: the left shoulder button, or bumper (LB, L1)
#: src/config.rs:163
msgid "Left Shoulder"
msgstr "Venstre skulderknap"

#. Translators: the right shoulder button, or bumper (RB, R1)
#: src/config.rs:165
msgid "Right Shoulder"
msgstr "Højre skulderknap"

#. Translators: pressing the left stick down like a button (LS, L3)
#: src/config.rs:167
msgid "Left Stick Click"
msgstr "Tryk på venstre styrepind"

#. Translators: pressing the right stick down like a button (RS, R3)
#: src/config.rs:169
msgid "Right Stick Click"
msgstr "Tryk på højre styrepind"

#. Translators: a control that does nothing
#: src/config.rs:293
msgid "Unassigned"
msgstr "Ikke tildelt"

#. Translators: an action of a game controller; to pan is to move
#. the view of the slide sideways
#: src/config.rs:296
msgid "Pan Horizontally"
msgstr "Panorér vandret"

#: src/config.rs:297
msgid "Pan Vertically"
msgstr "Panorér lodret"

#. Translators: for a stick or trigger: pushing it up or to the
#. right zooms in, the other way zooms out
#: src/config.rs:300
msgid "Zoom (Up / Right Zooms In)"
msgstr "Zoom (op/højre zoomer ind)"

#: src/config.rs:301
msgid "Zoom In"
msgstr "Zoom ind"

#: src/config.rs:302
msgid "Zoom Out"
msgstr "Zoom ud"

#. Translators: moves the mouse pointer of the operating system
#: src/config.rs:304
msgid "Move Pointer Horizontally"
msgstr "Flyt musemarkøren vandret"

#: src/config.rs:305
msgid "Move Pointer Vertically"
msgstr "Flyt musemarkøren lodret"

#. Translators: a pane is one of the views side by side in eov
#: src/config.rs:307
msgid "Previous Pane"
msgstr "Forrige rude"

#: src/config.rs:308
msgid "Next Pane"
msgstr "Næste rude"

#: src/config.rs:309
msgid "Previous Tab"
