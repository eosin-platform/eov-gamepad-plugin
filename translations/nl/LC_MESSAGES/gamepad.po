msgstr "Het controllersubsysteem kon niet starten: {}"

#: src/ui.rs:210
msgid "No controllers detected. Connect one by USB or Bluetooth."
msgstr "Geen controllers gevonden. Sluit er een aan via USB of Bluetooth."

#: src/ui.rs:214
