msgstr[1] "Klar: {n} kontrollere"

#. Translators: {} is the reason, from the system (often in English)
#: src/ui.rs:203
msgid "The controller subsystem could not start: {}"
msgstr "Delsystemet for kontrollere kunne ikke starte: {}"

#: src/ui.rs:210
