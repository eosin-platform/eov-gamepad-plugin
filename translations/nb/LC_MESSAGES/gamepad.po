#: src/ui.rs:306
msgid ""
"Changes are saved automatically. Save them as a profile to keep several "
"layouts."
msgstr ""
"Endringer lagres automatisk. Lagre dem som en profil for å beholde flere "
"oppsett."

#: src/ui.rs:309
msgid "Changes are saved automatically but not to a profile."
msgstr "Endringer lagres automatisk, men ikke i en profil."

