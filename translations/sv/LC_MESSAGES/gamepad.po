#: plugin.toml
msgctxt "plugin.toml"
msgid "Gamepad"
msgstr "Spelkontroll"

#: plugin.toml
msgctxt "plugin.toml"
msgid ""
"Provides support for using gamepads as input devices: pan, zoom and switch "
"panes, tabs and series items with a game controller."
msgstr ""
"Gör det möjligt att använda spelkontroller som indataenheter: panorera, "
"zooma och växla mellan rutor, flikar och objekt i serien med en spelkontroll."

#. Translators: the horizontal (X) axis of the left stick of a game
#. controller; keep the letter X
#: src/config.rs:136
msgid "Left Stick X"
msgstr "Vänster spak X"

#. Translators: the vertical (Y) axis of the left stick
#: src/config.rs:138
msgid "Left Stick Y"
msgstr "Vänster spak Y"

#. Translators: the horizontal (X) axis of the right stick
#: src/config.rs:140
msgid "Right Stick X"
msgstr "Höger spak X"

#. Translators: the vertical (Y) axis of the right stick
#: src/config.rs:142
msgid "Right Stick Y"
msgstr "Höger spak Y"

#. Translators: the analog trigger under the left shoulder (LT, L2)
#: src/config.rs:144
msgid "Left Trigger"
msgstr "Vänster avtryckare"

#. Translators: the analog trigger under the right shoulder (RT, R2)
#: src/config.rs:146
msgid "Right Trigger"
msgstr "Höger avtryckare"

#. Translators: D-Pad is the directional pad, the cross of four
#. buttons on the left of a game controller
#: src/config.rs:149
msgid "D-Pad Left"
msgstr "Styrkors vänster"

#: src/config.rs:150
msgid "D-Pad Right"
msgstr "Styrkors höger"

#: src/config.rs:151
msgid "D-Pad Up"
msgstr "Styrkors upp"

#: src/config.rs:152
msgid "D-Pad Down"
msgstr "Styrkors ned"

#. Translators: the four face buttons are named by their position:
#. the bottom one (A on Xbox, Cross on PlayStation, B on Nintendo)
#: src/config.rs:155
msgid "South Button"
msgstr "Nedre knapp"

#. Translators: the right face button (B on Xbox, Circle on PlayStation)
#: src/config.rs:157
msgid "East Button"
msgstr "Höger knapp"

#. Translators: the top face button (Y on Xbox, Triangle on PlayStation)
#: src/config.rs:159
msgid "North Button"
msgstr "Övre knapp"

#. Translators: the left face button (X on Xbox, Square on PlayStation)
#: src/config.rs:161
msgid "West Button"
msgstr "Vänster knapp"

#. Translators: the left shoulder button, or bumper (LB, L1)
#: src/config.rs:163
msgid "Left Shoulder"
msgstr "Vänster axelknapp"

#. Translators: the right shoulder button, or bumper (RB, R1)
#: src/config.rs:165
msgid "Right Shoulder"
msgstr "Höger axelknapp"

#. Translators: pressing the left stick down like a button (LS, L3)
#: src/config.rs:167
msgid "Left Stick Click"
msgstr "Vänster spak (tryck)"

#. Translators: pressing the right stick down like a button (RS, R3)
#: src/config.rs:169
msgid "Right Stick Click"
msgstr "Höger spak (tryck)"

#. Translators: a control that does nothing
#: src/config.rs:293
msgid "Unassigned"
msgstr "Ej tilldelad"

#. Translators: an action of a game controller; to pan is to move
#. the view of the slide sideways
#: src/config.rs:296
msgid "Pan Horizontally"
msgstr "Panorera vågrätt"

#: src/config.rs:297
msgid "Pan Vertically"
msgstr "Panorera lodrätt"

#. Translators: for a stick or trigger: pushing it up or to the
#. right zooms in, the other way zooms out
#: src/config.rs:300
msgid "Zoom (Up / Right Zooms In)"
msgstr "Zoom (upp/höger zoomar in)"

#: src/config.rs:301
msgid "Zoom In"
msgstr "Zooma in"

#: src/config.rs:302
msgid "Zoom Out"
msgstr "Zooma ut"

#. Translators: moves the mouse pointer of the operating system
#: src/config.rs:304
msgid "Move Pointer Horizontally"
msgstr "Flytta pekaren vågrätt"

#: src/config.rs:305
msgid "Move Pointer Vertically"
msgstr "Flytta pekaren lodrätt"

#. Translators: a pane is one of the views side by side in eov
#: src/config.rs:307
msgid "Previous Pane"
msgstr "Föregående ruta"

#: src/config.rs:308
msgid "Next Pane"
msgstr "Nästa ruta"

#: src/config.rs:309
msgid "Previous Tab"
msgstr "Föregående flik"

#: src/config.rs:310
msgid "Next Tab"
msgstr "Nästa flik"

#. Translators: the series bar lists the slides of a series
#: src/config.rs:312
msgid "Toggle Series Bar"
msgstr "Visa/dölj seriefältet"

#: src/config.rs:313
msgid "Previous Series Item"
msgstr "Föregående objekt i serien"

#: src/config.rs:314
msgid "Next Series Item"
msgstr "Nästa objekt i serien"

#: src/config.rs:315
msgid "Open Selected Series Item"
msgstr "Öppna markerat objekt i serien"

#. Translators: fits the whole slide into the view
#: src/config.rs:317
msgid "Fit View"
msgstr "Anpassa vyn"

#. Translators: this window is the gamepad settings window
#: src/config.rs:319
msgid "Show / Hide This Window"
msgstr "Visa/dölj det här fönstret"

#. Translators: turns gamepad input back on, or pauses it
#: src/config.rs:321
msgid "Enable / Pause"
msgstr "Aktivera/pausa"

#. Translators: a dead zone is how far a stick may move before it
#. counts as input (it hides stick drift); shown in a narrow column
#: src/config.rs:459
msgid "Left Dead Zone"
msgstr "Vänster dödzon"

#: src/config.rs:460
msgid "Right Dead Zone"
msgstr "Höger dödzon"

#: src/config.rs:461
msgid "Trigger Dead Zone"
msgstr "Avtryckarnas dödzon"

#: src/config.rs:462
msgid "Pan Speed"
msgstr "Panoreringsfart"

#: src/config.rs:463
msgid "Zoom Speed"
msgstr "Zoomhastighet"

#. Translators: how input grows with the deflection of a stick: a
#. higher curve gives finer control near the centre
#: src/config.rs:466
msgid "Response Curve"
msgstr "Responskurva"

#. Translators: the speed of the mouse pointer of the operating system
#: src/config.rs:468
msgid "Pointer Speed"
msgstr "Pekarhastighet"

#: src/config.rs:684
msgid "not a profile object"
msgstr "inte ett profilobjekt"

#. Translators: {} is the value of the "version" field of a profile
#: src/config.rs:694
msgid "ignoring the version {}"
msgstr "ignorerar versionen {}"

