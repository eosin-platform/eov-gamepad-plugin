#: plugin.toml
msgctxt "plugin.toml"
msgid "Gamepad"
msgstr "Gamepad"

#: plugin.toml
msgctxt "plugin.toml"
msgid ""
"Provides support for using gamepads as input devices: pan, zoom and switch "
"panes, tabs and series items with a game controller."
msgstr ""
"Permite folosirea gamepadurilor ca dispozitive de intrare: deplasați "
"vizualizarea, faceți zoom și comutați între panouri, file și elemente ale "
"seriei cu un controler de joc."

#. Translators: the horizontal (X) axis of the left stick of a game
#. controller; keep the letter X
#: src/config.rs:136
msgid "Left Stick X"
msgstr "Stick stâng X"

#. Translators: the vertical (Y) axis of the left stick
#: src/config.rs:138
msgid "Left Stick Y"
msgstr "Stick stâng Y"

#. Translators: the horizontal (X) axis of the right stick
#: src/config.rs:140
msgid "Right Stick X"
msgstr "Stick drept X"

#. Translators: the vertical (Y) axis of the right stick
#: src/config.rs:142
msgid "Right Stick Y"
msgstr "Stick drept Y"

#. Translators: the analog trigger under the left shoulder (LT, L2)
#: src/config.rs:144
msgid "Left Trigger"
msgstr "Trăgaci stâng"

#. Translators: the analog trigger under the right shoulder (RT, R2)
#: src/config.rs:146
msgid "Right Trigger"
msgstr "Trăgaci drept"

#. Translators: D-Pad is the directional pad, the cross of four
#. buttons on the left of a game controller
#: src/config.rs:149
msgid "D-Pad Left"
msgstr "D-pad stânga"

#: src/config.rs:150
msgid "D-Pad Right"
msgstr "D-pad dreapta"

#: src/config.rs:151
msgid "D-Pad Up"
msgstr "D-pad sus"

#: src/config.rs:152
msgid "D-Pad Down"
msgstr "D-pad jos"

#. Translators: the four face buttons are named by their position:
#. the bottom one (A on Xbox, Cross on PlayStation, B on Nintendo)
#: src/config.rs:155
msgid "South Button"
msgstr "Buton de jos"

#. Translators: the right face button (B on Xbox, Circle on PlayStation)
#: src/config.rs:157
msgid "East Button"
msgstr "Buton din dreapta"

#. Translators: the top face button (Y on Xbox, Triangle on PlayStation)
#: src/config.rs:159
msgid "North Button"
msgstr "Buton de sus"

#. Translators: the left face button (X on Xbox, Square on PlayStation)
#: src/config.rs:161
msgid "West Button"
msgstr "Buton din stânga"

#. Translators: the left shoulder button, or bumper (LB, L1)
#: src/config.rs:163
msgid "Left Shoulder"
msgstr "Buton de umăr stâng"

#. Translators: the right shoulder button, or bumper (RB, R1)
#: src/config.rs:165
msgid "Right Shoulder"
msgstr "Buton de umăr drept"

#. Translators: pressing the left stick down like a button (LS, L3)
#: src/config.rs:167
msgid "Left Stick Click"
msgstr "Apăsare stick stâng"

#. Translators: pressing the right stick down like a button (RS, R3)
#: src/config.rs:169
msgid "Right Stick Click"
msgstr "Apăsare stick drept"

#. Translators: a control that does nothing
#: src/config.rs:293
msgid "Unassigned"
msgstr "Neatribuit"

#. Translators: an action of a game controller; to pan is to move
#. the view of the slide sideways
#: src/config.rs:296
msgid "Pan Horizontally"
msgstr "Deplasează orizontal"

#: src/config.rs:297
msgid "Pan Vertically"
msgstr "Deplasează vertical"

#. Translators: for a stick or trigger: pushing it up or to the
#. right zooms in, the other way zooms out
#: src/config.rs:300
msgid "Zoom (Up / Right Zooms In)"
msgstr "Zoom (sus / dreapta mărește)"

#: src/config.rs:301
msgid "Zoom In"
msgstr "Mărește"

#: src/config.rs:302
msgid "Zoom Out"
msgstr "Micșorează"

#. Translators: moves the mouse pointer of the operating system
#: src/config.rs:304
msgid "Move Pointer Horizontally"
msgstr "Mută cursorul orizontal"

#: src/config.rs:305
msgid "Move Pointer Vertically"
msgstr "Mută cursorul vertical"

#. Translators: a pane is one of the views side by side in eov
#: src/config.rs:307
msgid "Previous Pane"
msgstr "Panoul anterior"

#: src/config.rs:308
msgid "Next Pane"
msgstr "Panoul următor"

#: src/config.rs:309
msgid "Previous Tab"
msgstr "Fila anterioară"

#: src/config.rs:310
msgid "Next Tab"
msgstr "Fila următoare"

#. Translators: the series bar lists the slides of a series
#: src/config.rs:312
msgid "Toggle Series Bar"
msgstr "Afișează/ascunde bara seriei"

#: src/config.rs:313
msgid "Previous Series Item"
msgstr "Elementul anterior din serie"

#: src/config.rs:314
msgid "Next Series Item"
msgstr "Elementul următor din serie"

#: src/config.rs:315
msgid "Open Selected Series Item"
msgstr "Deschide elementul selectat din serie"

#. Translators: fits the whole slide into the view
#: src/config.rs:317
msgid "Fit View"
msgstr "Încadrează lama în panou"

#. Translators: this window is the gamepad settings window
#: src/config.rs:319
msgid "Show / Hide This Window"
msgstr "Afișează / ascunde această fereastră"

#. Translators: turns gamepad input back on, or pauses it
#: src/config.rs:321
msgid "Enable / Pause"
msgstr "Activează / pune pe pauză"

#. Translators: a dead zone is how far a stick may move before it
#. counts as input (it hides stick drift); shown in a narrow column
#: src/config.rs:459
msgid "Left Dead Zone"
msgstr "Zona moartă stânga"

#: src/config.rs:460
msgid "Right Dead Zone"
msgstr "Zona moartă dreapta"

#: src/config.rs:461
msgid "Trigger Dead Zone"
msgstr "Zona moartă trăgace"

#: src/config.rs:462
msgid "Pan Speed"
msgstr "Viteza de deplasare"

#: src/config.rs:463
msgid "Zoom Speed"
msgstr "Viteza de zoom"

#. Translators: how input grows with the deflection of a stick: a
#. higher curve gives finer control near the centre
#: src/config.rs:466
msgid "Response Curve"
msgstr "Curba de răspuns"

#. Translators: the speed of the mouse pointer of the operating system
#: src/config.rs:468
msgid "Pointer Speed"
msgstr "Viteza cursorului"

#: src/config.rs:684
msgid "not a profile object"
msgstr "nu este un obiect de profil"

#. Translators: {} is the value of the "version" field of a profile
#: src/config.rs:694
msgid "ignoring the version {}"
msgstr "se ignoră versiunea {}"

