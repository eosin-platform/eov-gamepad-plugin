msgstr "Subsistemul de controlere nu a putut porni: {}"

#: src/ui.rs:210
msgid "No controllers detected. Connect one by USB or Bluetooth."
msgstr ""
"Nu s-a detectat niciun controler. Conectați unul prin USB sau Bluetooth."

#: src/ui.rs:214
msgid "The chosen controller is not connected, so every controller is used."
msgstr ""
"Controlerul ales nu este conectat, așa că se folosesc toate controlerele."

#: src/ui.rs:216
msgid "Every connected controller drives eov."
msgstr "Toate controlerele conectate comandă eov."

#. Translators: "Move Pointer" stands for the actions "Move Pointer
#. Horizontally" and "Move Pointer Vertically" of the mappings
#: src/ui.rs:228
msgid ""
"Your mappings include Move Pointer. Turn this on to let them move the system "
"pointer while eov has focus."
msgstr ""
"Atribuirile dvs. includ „Mută cursorul”. Activați această opțiune pentru a "
"le permite să miște cursorul sistemului cât timp eov este fereastra activă."

#. Translators: "Move Pointer" stands for the actions "Move Pointer
#. Horizontally" and "Move Pointer Vertically"; Remote Desktop and
#. Accessibility are the names of system permissions: write them as
#. the system shows them in your language
#: src/ui.rs:237
msgid ""
"Off. When on, Move Pointer mappings move the system pointer while eov has "
"focus. Wayland asks for Remote Desktop permission and macOS for "
"Accessibility access."
msgstr ""
"Dezactivat. Când este activat, atribuirile „Mută cursorul” mișcă cursorul "
"sistemului cât timp eov este fereastra activă. Wayland solicită permisiunea "
"Remote Desktop, iar macOS accesul la Accesibilitate."

#: src/ui.rs:246
msgid "On. Starts when a mapped stick moves."
msgstr "Activat. Pornește când se mișcă un stick atribuit."

#: src/ui.rs:248
msgid ""
"On. Starts when a mapped stick moves. Map a stick to Move Pointer to use it."
msgstr ""
"Activat. Pornește când se mișcă un stick atribuit. Atribuiți unui stick "
"acțiunea „Mută cursorul” pentru a-l folosi."

#: src/ui.rs:250
msgid "Connecting. The system may ask for permission."
msgstr "Se conectează. Sistemul poate cere permisiunea."

#: src/ui.rs:252
msgid ""
"Connecting. The system may ask for permission. Map a stick to Move Pointer "
"to use it."
msgstr ""
"Se conectează. Sistemul poate cere permisiunea. Atribuiți unui stick "
"acțiunea „Mută cursorul” pentru a-l folosi."

#. Translators: {} is how the pointer is moved, such as "XTest" or
#. "Remote Desktop portal"
#: src/ui.rs:257
msgid "Active ({})."
msgstr "Activ ({})."

#: src/ui.rs:259
msgid "Active ({}). Map a stick to Move Pointer to use it."
msgstr ""
"Activ ({}). Atribuiți unui stick acțiunea „Mută cursorul” pentru a-l folosi."

#. Translators: {} is the reason
#: src/ui.rs:263
msgid "Not available: {}"
msgstr "Indisponibil: {}"

#. Translators: {} is the reason, a phrase without a full stop
#: src/ui.rs:267
msgid "Not available: {}. Map a stick to Move Pointer to use it."
msgstr ""
"Indisponibil: {}. Atribuiți unui stick acțiunea „Mută cursorul” pentru a-l "
"folosi."

#. Translators: the first entry of the list of controllers
#: src/ui.rs:279
msgid "All controllers"
msgstr "Toate controlerele"

#. Translators: {} is the name of the selected profile
#: src/ui.rs:304
msgid "Changes are saved to “{}”."
msgstr "Modificările se salvează în „{}”."

#: src/ui.rs:306
msgid ""
"Changes are saved automatically. Save them as a profile to keep several "
"layouts."
msgstr ""
"Modificările se salvează automat. Salvați-le ca profil pentru a păstra mai "
"multe configurații."

#: src/ui.rs:309
msgid "Changes are saved automatically but not to a profile."
msgstr "Modificările se salvează automat, dar nu într-un profil."

