msgstr "se ignora el perfil {}: {}"

#: src/config.rs:983
msgid "Enter a name for the profile."
msgstr "Escriba un nombre para el perfil."

#: src/config.rs:986
msgid "Profile names are limited to {n} character."
msgid_plural "Profile names are limited to {n} characters."
msgstr[0] "Los nombres de perfil están limitados a {n} carácter."
msgstr[1] "Los nombres de perfil están limitados a {n} caracteres."

#: src/config.rs:991
