#: plugin.toml
msgctxt "plugin.toml"
msgid "Gamepad"
msgstr "Mando de juego"

#: plugin.toml
msgctxt "plugin.toml"
msgid ""
"Provides support for using gamepads as input devices: pan, zoom and switch "
"panes, tabs and series items with a game controller."
msgstr ""
"Permite usar mandos de juego como dispositivos de entrada: desplazar la "
"vista, hacer zoom y cambiar de panel, de pestaña y de elemento de la serie "
"con un mando de juego."

#. Translators: the horizontal (X) axis of the left stick of a game
#. controller; keep the letter X
#: src/config.rs:136
msgid "Left Stick X"
msgstr "Joystick izquierdo X"

#. Translators: the vertical (Y) axis of the left stick
#: src/config.rs:138
msgid "Left Stick Y"
msgstr "Joystick izquierdo Y"

#. Translators: the horizontal (X) axis of the right stick
#: src/config.rs:140
msgid "Right Stick X"
msgstr "Joystick derecho X"

#. Translators: the vertical (Y) axis of the right stick
#: src/config.rs:142
msgid "Right Stick Y"
msgstr "Joystick derecho Y"

#. Translators: the analog trigger under the left shoulder (LT, L2)
#: src/config.rs:144
msgid "Left Trigger"
msgstr "Gatillo izquierdo"

#. Translators: the analog trigger under the right shoulder (RT, R2)
#: src/config.rs:146
msgid "Right Trigger"
msgstr "Gatillo derecho"

#. Translators: D-Pad is the directional pad, the cross of four
#. buttons on the left of a game controller
#: src/config.rs:149
msgid "D-Pad Left"
msgstr "Cruceta: izquierda"

#: src/config.rs:150
msgid "D-Pad Right"
msgstr "Cruceta: derecha"

#: src/config.rs:151
msgid "D-Pad Up"
msgstr "Cruceta: arriba"

#: src/config.rs:152
msgid "D-Pad Down"
msgstr "Cruceta: abajo"

#. Translators: the four face buttons are named by their position:
#. the bottom one (A on Xbox, Cross on PlayStation, B on Nintendo)
#: src/config.rs:155
msgid "South Button"
msgstr "Botón sur"

#. Translators: the right face button (B on Xbox, Circle on PlayStation)
#: src/config.rs:157
msgid "East Button"
msgstr "Botón este"

#. Translators: the top face button (Y on Xbox, Triangle on PlayStation)
#: src/config.rs:159
msgid "North Button"
msgstr "Botón norte"

#. Translators: the left face button (X on Xbox, Square on PlayStation)
#: src/config.rs:161
msgid "West Button"
msgstr "Botón oeste"

#. Translators: the left shoulder button, or bumper (LB, L1)
#: src/config.rs:163
msgid "Left Shoulder"
msgstr "Botón superior izquierdo"

#. Translators: the right shoulder button, or bumper (RB, R1)
#: src/config.rs:165
msgid "Right Shoulder"
msgstr "Botón superior derecho"

#. Translators: pressing the left stick down like a button (LS, L3)
#: src/config.rs:167
msgid "Left Stick Click"
msgstr "Pulsación del joystick izquierdo"

#. Translators: pressing the right stick down like a button (RS, R3)
#: src/config.rs:169
msgid "Right Stick Click"
msgstr "Pulsación del joystick derecho"

#. Translators: a control that does nothing
#: src/config.rs:293
msgid "Unassigned"
msgstr "Sin asignar"

#. Translators: an action of a game controller; to pan is to move
#. the view of the slide sideways
#: src/config.rs:296
msgid "Pan Horizontally"
msgstr "Desplazar en horizontal"

#: src/config.rs:297
msgid "Pan Vertically"
msgstr "Desplazar en vertical"

#. Translators: for a stick or trigger: pushing it up or to the
#. right zooms in, the other way zooms out
#: src/config.rs:300
msgid "Zoom (Up / Right Zooms In)"
msgstr "Zoom (arriba / derecha acerca)"

#: src/config.rs:301
msgid "Zoom In"
msgstr "Acercar"

#: src/config.rs:302
msgid "Zoom Out"
msgstr "Alejar"

#. Translators: moves the mouse pointer of the operating system
#: src/config.rs:304
msgid "Move Pointer Horizontally"
msgstr "Mover el puntero en horizontal"

#: src/config.rs:305
msgid "Move Pointer Vertically"
msgstr "Mover el puntero en vertical"

#. Translators: a pane is one of the views side by side in eov
#: src/config.rs:307
msgid "Previous Pane"
msgstr "Panel anterior"

#: src/config.rs:308
msgid "Next Pane"
msgstr "Panel siguiente"

#: src/config.rs:309
msgid "Previous Tab"
msgstr "Pestaña anterior"

#: src/config.rs:310
msgid "Next Tab"
msgstr "Pestaña siguiente"

#. Translators: the series bar lists the slides of a series
#: src/config.rs:312
msgid "Toggle Series Bar"
msgstr "Mostrar u ocultar la barra de series"

#: src/config.rs:313
msgid "Previous Series Item"
msgstr "Elemento anterior de la serie"

#: src/config.rs:314
msgid "Next Series Item"
msgstr "Elemento siguiente de la serie"

#: src/config.rs:315
msgid "Open Selected Series Item"
msgstr "Abrir el elemento seleccionado de la serie"

#. Translators: fits the whole slide into the view
#: src/config.rs:317
msgid "Fit View"
msgstr "Ajustar la vista"

#. Translators: this window is the gamepad settings window
#: src/config.rs:319
msgid "Show / Hide This Window"
msgstr "Mostrar u ocultar esta ventana"

#. Translators: turns gamepad input back on, or pauses it
#: src/config.rs:321
msgid "Enable / Pause"
msgstr "Activar / Pausar"

#. Translators: a dead zone is how far a stick may move before it
#. counts as input (it hides stick drift); shown in a narrow column
#: src/config.rs:459
msgid "Left Dead Zone"
msgstr "Zona muerta izq."

#: src/config.rs:460
msgid "Right Dead Zone"
msgstr "Zona muerta der."

#: src/config.rs:461
msgid "Trigger Dead Zone"
msgstr "Zona muerta gatillos"

#: src/config.rs:462
msgid "Pan Speed"
msgstr "Vel. desplazamiento"

#: src/config.rs:463
msgid "Zoom Speed"
msgstr "Velocidad de zoom"

#. Translators: how input grows with the deflection of a stick: a
#. higher curve gives finer control near the centre
#: src/config.rs:466
msgid "Response Curve"
msgstr "Curva de respuesta"

#. Translators: the speed of the mouse pointer of the operating system
#: src/config.rs:468
msgid "Pointer Speed"
msgstr "Vel. del puntero"

