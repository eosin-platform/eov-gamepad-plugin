#: src/plugin.rs:272
msgid "The profile “{}” no longer exists."
msgstr "प्रोफ़ाइल “{}” अब मौजूद नहीं है।"

#. Translators: the name of a new profile when none was typed
#: src/plugin.rs:280
msgctxt "Profile name"
msgid "Untitled"
msgstr "शीर्षकहीन"

#. Translators: {} is the name of a profile
#: src/plugin.rs:310
msgid ""
"A profile named “{}” already exists. Replace it with the default settings?"
msgstr "“{}” नाम की प्रोफ़ाइल पहले से मौजूद है। क्या उसे डिफ़ॉल्ट सेटिंग्स से बदलना है?"

#. Translators: {} is the name of a profile
#: src/plugin.rs:316
msgid ""
"A profile named “{}” already exists. Replace it with the current settings?"
msgstr "“{}” नाम की प्रोफ़ाइल पहले से मौजूद है। क्या उसे वर्तमान सेटिंग्स से बदलना है?"

#: src/plugin.rs:321
msgid "Replace profile?"
msgstr "प्रोफ़ाइल बदलें?"

