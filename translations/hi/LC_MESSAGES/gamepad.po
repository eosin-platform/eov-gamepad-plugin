msgstr "सक्रिय ({})।"

#: src/ui.rs:259
msgid "Active ({}). Map a stick to Move Pointer to use it."
msgstr "सक्रिय ({})। इसका उपयोग करने के लिए किसी स्टिक को “पॉइंटर ले जाएँ” से मैप करें।"

#. Translators: {} is the reason
#: src/ui.rs:263
msgid "Not available: {}"
msgstr "उपलब्ध नहीं: {}"

#. Translators: {} is the reason, a phrase without a full stop
#: src/ui.rs:267
msgid "Not available: {}. Map a stick to Move Pointer to use it."
msgstr ""
"उपलब्ध नहीं: {}। इसका उपयोग करने के लिए किसी स्टिक को “पॉइंटर ले जाएँ” से मैप करें।"

#. Translators: the first entry of the list of controllers
#: src/ui.rs:279
msgid "All controllers"
msgstr "सभी कंट्रोलर"

#. Translators: {} is the name of the selected profile
#: src/ui.rs:304
msgid "Changes are saved to “{}”."
msgstr "परिवर्तन “{}” में सहेजे जाते हैं।"

#: src/ui.rs:306
msgid ""
"Changes are saved automatically. Save them as a profile to keep several "
"layouts."
msgstr "परिवर्तन अपने-आप सहेजे जाते हैं। कई लेआउट रखने के लिए उन्हें प्रोफ़ाइल के रूप में सहेजें।"

#: src/ui.rs:309
msgid "Changes are saved automatically but not to a profile."
msgstr "परिवर्तन अपने-आप सहेजे जाते हैं, लेकिन किसी प्रोफ़ाइल में नहीं।"

