msgstr "सिस्टम पॉइंटर नियंत्रण बंद कर दिया गया: {}"

#: src/pointer.rs:221
msgid "System pointer control is not available"
msgstr "सिस्टम पॉइंटर नियंत्रण उपलब्ध नहीं है"

#. Translators: the Remote Desktop portal as in "Remote Desktop portal"; {} is the
#. portal's own error, often in English
#: src/pointer.rs:312
msgid "the Remote Desktop portal is not available ({})"
msgstr "Remote Desktop पोर्टल उपलब्ध नहीं है ({})"

#: src/pointer.rs:316
msgid "cannot create a portal session ({})"
msgstr "पोर्टल सत्र नहीं बनाया जा सकता ({})"

#: src/pointer.rs:325
