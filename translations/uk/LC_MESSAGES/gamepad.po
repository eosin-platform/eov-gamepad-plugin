#: plugin.toml
msgctxt "plugin.toml"
msgid "Gamepad"
msgstr "Геймпад"

#: plugin.toml
msgctxt "plugin.toml"
msgid ""
"Provides support for using gamepads as input devices: pan, zoom and switch "
"panes, tabs and series items with a game controller."
msgstr ""
"Дає змогу використовувати геймпади як пристрої введення: переміщення, "
"масштабування та перемикання областей перегляду, вкладок і елементів серії "
"за допомогою ігрового контролера."

#. Translators: the horizontal (X) axis of the left stick of a game
#. controller; keep the letter X
#: src/config.rs:136
msgid "Left Stick X"
msgstr "Лівий стік X"

#. Translators: the vertical (Y) axis of the left stick
#: src/config.rs:138
msgid "Left Stick Y"
msgstr "Лівий стік Y"

#. Translators: the horizontal (X) axis of the right stick
#: src/config.rs:140
msgid "Right Stick X"
msgstr "Правий стік X"

#. Translators: the vertical (Y) axis of the right stick
#: src/config.rs:142
msgid "Right Stick Y"
msgstr "Правий стік Y"

#. Translators: the analog trigger under the left shoulder (LT, L2)
#: src/config.rs:144
msgid "Left Trigger"
msgstr "Лівий тригер"

#. Translators: the analog trigger under the right shoulder (RT, R2)
#: src/config.rs:146
msgid "Right Trigger"
msgstr "Правий тригер"

#. Translators: D-Pad is the directional pad, the cross of four
#. buttons on the left of a game controller
#: src/config.rs:149
msgid "D-Pad Left"
msgstr "Хрестовина ліворуч"

#: src/config.rs:150
msgid "D-Pad Right"
msgstr "Хрестовина праворуч"

#: src/config.rs:151
msgid "D-Pad Up"
msgstr "Хрестовина вгору"

#: src/config.rs:152
msgid "D-Pad Down"
msgstr "Хрестовина вниз"

#. Translators: the four face buttons are named by their position:
#. the bottom one (A on Xbox, Cross on PlayStation, B on Nintendo)
#: src/config.rs:155
msgid "South Button"
msgstr "Нижня кнопка"

#. Translators: the right face button (B on Xbox, Circle on PlayStation)
#: src/config.rs:157
msgid "East Button"
msgstr "Права кнопка"

#. Translators: the top face button (Y on Xbox, Triangle on PlayStation)
#: src/config.rs:159
msgid "North Button"
msgstr "Верхня кнопка"

#. Translators: the left face button (X on Xbox, Square on PlayStation)
#: src/config.rs:161
msgid "West Button"
msgstr "Ліва кнопка"

#. Translators: the left shoulder button, or bumper (LB, L1)
#: src/config.rs:163
msgid "Left Shoulder"
msgstr "Лівий бампер"

#. Translators: the right shoulder button, or bumper (RB, R1)
#: src/config.rs:165
msgid "Right Shoulder"
msgstr "Правий бампер"

#. Translators: pressing the left stick down like a button (LS, L3)
#: src/config.rs:167
msgid "Left Stick Click"
msgstr "Натискання лівого стіка"

#. Translators: pressing the right stick down like a button (RS, R3)
#: src/config.rs:169
msgid "Right Stick Click"
msgstr "Натискання правого стіка"

#. Translators: a control that does nothing
#: src/config.rs:293
msgid "Unassigned"
msgstr "Не призначено"

#. Translators: an action of a game controller; to pan is to move
#. the view of the slide sideways
#: src/config.rs:296
msgid "Pan Horizontally"
msgstr "Переміщення по горизонталі"

#: src/config.rs:297
msgid "Pan Vertically"
msgstr "Переміщення по вертикалі"

#. Translators: for a stick or trigger: pushing it up or to the
#. right zooms in, the other way zooms out
#: src/config.rs:300
msgid "Zoom (Up / Right Zooms In)"
msgstr "Масштаб (вгору / праворуч — наблизити)"

#: src/config.rs:301
msgid "Zoom In"
msgstr "Наблизити"

#: src/config.rs:302
msgid "Zoom Out"
msgstr "Віддалити"

#. Translators: moves the mouse pointer of the operating system
#: src/config.rs:304
msgid "Move Pointer Horizontally"
msgstr "Рух вказівника по горизонталі"

#: src/config.rs:305
msgid "Move Pointer Vertically"
msgstr "Рух вказівника по вертикалі"

#. Translators: a pane is one of the views side by side in eov
#: src/config.rs:307
msgid "Previous Pane"
msgstr "Попередня область перегляду"

#: src/config.rs:308
msgid "Next Pane"
msgstr "Наступна область перегляду"

#: src/config.rs:309
msgid "Previous Tab"
msgstr "Попередня вкладка"

#: src/config.rs:310
msgid "Next Tab"
msgstr "Наступна вкладка"

#. Translators: the series bar lists the slides of a series
#: src/config.rs:312
msgid "Toggle Series Bar"
msgstr "Показати/сховати панель серії"

#: src/config.rs:313
msgid "Previous Series Item"
msgstr "Попередній елемент серії"

#: src/config.rs:314
msgid "Next Series Item"
msgstr "Наступний елемент серії"

#: src/config.rs:315
msgid "Open Selected Series Item"
msgstr "Відкрити вибраний елемент серії"

#. Translators: fits the whole slide into the view
#: src/config.rs:317
msgid "Fit View"
msgstr "Вписати препарат"

#. Translators: this window is the gamepad settings window
#: src/config.rs:319
msgid "Show / Hide This Window"
msgstr "Показати/сховати це вікно"

#. Translators: turns gamepad input back on, or pauses it
#: src/config.rs:321
msgid "Enable / Pause"
msgstr "Увімкнути / призупинити"

#. Translators: a dead zone is how far a stick may move before it
#. counts as input (it hides stick drift); shown in a narrow column
#: src/config.rs:459
msgid "Left Dead Zone"
msgstr "Мертва зона лів."

#: src/config.rs:460
msgid "Right Dead Zone"
msgstr "Мертва зона прав."

#: src/config.rs:461
msgid "Trigger Dead Zone"
msgstr "Мертва зона триг."

#: src/config.rs:462
msgid "Pan Speed"
msgstr "Швидк. руху"

#: src/config.rs:463
msgid "Zoom Speed"
msgstr "Швидк. масштабу"

#. Translators: how input grows with the deflection of a stick: a
#. higher curve gives finer control near the centre
#: src/config.rs:466
msgid "Response Curve"
msgstr "Крива відгуку"

#. Translators: the speed of the mouse pointer of the operating system
#: src/config.rs:468
msgid "Pointer Speed"
msgstr "Швидк. вказівника"

#: src/config.rs:684
msgid "not a profile object"
msgstr "не є об’єктом профілю"

#. Translators: {} is the value of the "version" field of a profile
#: src/config.rs:694
msgid "ignoring the version {}"
msgstr "ігнорується версія {}"

#. Translators: {key} is a field of a profile file, such as
#. 'pan_sensitivity'; {value} is what the field holds
#: src/config.rs:712
msgid "ignoring '{key}': {value} is not a number"
msgstr "ігнорується «{key}»: {value} не є числом"

#. Translators: 'mappings' is a field of a profile file: keep the name
#: src/config.rs:730
msgid "ignoring 'mappings': not an object"
msgstr "ігнорується «mappings»: це не об’єкт"

#: src/config.rs:745
msgid "the file is not a gamepad profile"
msgstr "файл не є профілем геймпада"

#: src/config.rs:794
msgid "the stored gamepad settings are not an object"
msgstr "збережені параметри геймпада не є об’єктом"

#. Translators: {key} is a stored setting, such as 'enabled'; {error}
#. says why it cannot be read
#: src/config.rs:809
msgid "ignoring the stored '{key}': {error}"
msgstr "ігнорується збережений параметр «{key}»: {error}"

#. Translators: {} is a problem with the current settings (not a profile)
#: src/config.rs:840
msgid "settings: {}"
msgstr "параметри: {}"

#: src/config.rs:843
msgid "ignoring the stored settings: {}"
msgstr "збережені параметри ігноруються: {}"

#: src/config.rs:854
msgid "ignoring the profile with the name {}"
msgstr "ігнорується профіль з назвою {}"

#: src/config.rs:859
msgid "ignoring the profile {name}: at most {n} profile is kept"
msgid_plural "ignoring the profile {name}: at most {n} profiles are kept"
msgstr[0] "ігнорується профіль {name}: зберігається не більше ніж {n} профіль"
msgstr[1] "ігнорується профіль {name}: зберігається не більше ніж {n} профілі"
msgstr[2] "ігнорується профіль {name}: зберігається не більше ніж {n} профілів"

#. Translators: {name} is the name of a profile,
#. {problem} what is wrong with it
#: src/config.rs:873
msgid "{name}: {problem}"
msgstr "{name}: {problem}"

#. Translators: the name of a profile, then why it cannot be read
#: src/config.rs:881
msgid "ignoring the profile {}: {}"
msgstr "ігнорується профіль {}: {}"

#: src/config.rs:983
msgid "Enter a name for the profile."
msgstr "Введіть назву профілю."

#: src/config.rs:986
msgid "Profile names are limited to {n} character."
msgid_plural "Profile names are limited to {n} characters."
msgstr[0] "Назва профілю може містити щонайбільше {n} символ."
msgstr[1] "Назва профілю може містити щонайбільше {n} символи."
msgstr[2] "Назва профілю може містити щонайбільше {n} символів."

#: src/config.rs:991
msgid "Profile names cannot contain control characters."
msgstr "Назва профілю не може містити керівних символів."

#. Translators: the name given to a profile whose name would be empty
#: src/config.rs:1003
msgctxt "Profile name"
msgid "Profile"
msgstr "Профіль"

#. Translators: shown after the name of a controller; {level} is the
#. charge of its battery in percent
#: src/engine.rs:74
msgid "battery {level}%"
msgstr "батарея {level} %"

#. Translators: shown after the name of a controller; {level} is the
#. charge of its battery in percent
#: src/engine.rs:77
msgid "charging, {level}%"
msgstr "заряджається, {level} %"

#. Translators: shown after the name of a controller: its battery is full
#: src/engine.rs:79
msgid "charged"
msgstr "заряджено"

#. Translators: {} is a folder of the system, such as /dev/input
#: src/environment.rs:88
msgid "{} is not available, so no controller can be opened."
msgstr "Папка {} недоступна, тому неможливо відкрити жоден контролер."

#. Translators: udev is the Linux device manager and uaccess the name
#. of its tag: keep both
#: src/environment.rs:112
msgid ""
"A game controller is connected, but eov is not allowed to read it. udev "
"normally gives the logged-in user access to controllers (the uaccess tag); "
"if yours is not recognised as a joystick, add a udev rule that tags it with "
"uaccess, then reconnect it."
msgstr ""
"Ігровий контролер підключено, але eov не має дозволу на його читання. "
"Зазвичай udev надає користувачеві, який увійшов у систему, доступ до "
"контролерів (тег uaccess); якщо ваш контролер не розпізнається як джойстик, "
"додайте правило udev, що позначає його тегом uaccess, а потім підключіть "
"його знову."

#. Translators: {command} is a command to type and {option} one of
#. its options: they stay as they are
#: src/environment.rs:124
msgid ""
"eov runs as a Flatpak without access to input devices. Allow it by running "
"{command} (Flatpak 1.15.6 or newer; older versions need {option}), then "
"restart eov."
msgstr ""
"eov працює як Flatpak без доступу до пристроїв введення. Надайте доступ "
"командою {command} (Flatpak 1.15.6 або новіший; для старіших версій потрібен "
"параметр {option}), потім перезапустіть eov."

#. Translators: the type of file in the file dialog
#: src/plugin.rs:91
msgid "Gamepad profile"
msgstr "Профіль геймпада"

#. Translators: the tooltip of the toolbar button, and the title of
#. the gamepad settings window
#: src/plugin.rs:100 src/ui.rs:26
msgid "Gamepad"
msgstr "Геймпад"

#: src/plugin.rs:108
msgid "the path has no file name"
msgstr "шлях не містить імені файлу"

#: src/plugin.rs:123
msgid "the file is too large to be a gamepad profile"
msgstr "файл завеликий для профілю геймпада"

#: src/plugin.rs:212
msgid "Cannot open the gamepad window"
msgstr "Неможливо відкрити вікно геймпада"

#. Translators: {} is the name of a profile
#: src/plugin.rs:272
msgid "The profile “{}” no longer exists."
msgstr "Профілю «{}» більше не існує."

#. Translators: the name of a new profile when none was typed
#: src/plugin.rs:280
msgctxt "Profile name"
msgid "Untitled"
msgstr "Без назви"

#. Translators: {} is the name of a profile
#: src/plugin.rs:310
msgid ""
"A profile named “{}” already exists. Replace it with the default settings?"
msgstr "Профіль з назвою «{}» уже існує. Замінити його типовими параметрами?"

#. Translators: {} is the name of a profile
#: src/plugin.rs:316
msgid ""
"A profile named “{}” already exists. Replace it with the current settings?"
msgstr "Профіль з назвою «{}» уже існує. Замінити його поточними параметрами?"

#: src/plugin.rs:321
msgid "Replace profile?"
msgstr "Замінити профіль?"

#. Translators: a button: replaces the profile
#: src/plugin.rs:324
msgid "Replace"
msgstr "Замінити"

#: src/plugin.rs:325 src/plugin.rs:370
msgid "Cancel"
msgstr "Скасувати"

#: src/plugin.rs:338
msgid "You already have {n} profile. Delete one to save another."
msgid_plural "You already have {n} profiles. Delete one to save another."
msgstr[0] "У вас уже є {n} профіль. Видаліть один, щоб зберегти інший."
msgstr[1] "У вас уже є {n} профілі. Видаліть один, щоб зберегти інший."
msgstr[2] "У вас уже є {n} профілів. Видаліть один, щоб зберегти інший."

#: src/plugin.rs:358
msgid "Choose a saved profile to delete."
msgstr "Виберіть збережений профіль, який потрібно видалити."

#: src/plugin.rs:362
msgid "Delete profile?"
msgstr "Видалити профіль?"

#. Translators: {} is the name of a profile
#: src/plugin.rs:365
msgid "Delete the profile “{}”? This cannot be undone."
msgstr "Видалити профіль «{}»? Цю дію неможливо відмінити."

#. Translators: a button: deletes the profile
#: src/plugin.rs:369
msgid "Delete"
msgstr "Видалити"

#: src/plugin.rs:384
msgid "Import a gamepad profile"
msgstr "Імпорт профілю геймпада"

#. Translators: the name of an exported profile when none is selected
#: src/plugin.rs:401
msgctxt "Profile name"
msgid "Gamepad profile"
msgstr "Профіль геймпада"

#: src/plugin.rs:407
msgid "Export the gamepad profile"
msgstr "Експорт профілю геймпада"

#. Translators: {} is the path of a file
#: src/plugin.rs:465
msgid "Cannot import {}"
msgstr "Не вдалося імпортувати {}"

#. Translators: the name of an imported profile when its file name
#. cannot be used
#: src/plugin.rs:478
msgctxt "Profile name"
