#: src/plugin.rs:502
msgid "You already have {n} profile. Delete one to import another."
msgid_plural "You already have {n} profiles. Delete one to import another."
msgstr[0] "У вас уже є {n} профіль. Видаліть один, щоб імпортувати інший."
msgstr[1] "У вас уже є {n} профілі. Видаліть один, щоб імпортувати інший."
msgstr[2] "У вас уже є {n} профілів. Видаліть один, щоб імпортувати інший."

