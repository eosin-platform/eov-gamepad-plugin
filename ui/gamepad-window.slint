// The gamepad settings window: a plugin surface of kind Window.
//
// Every value is pushed by the plugin (`Surface::set_many`); callbacks go back
// to it (`Plugin::ui_callback`). Ranges, labels and defaults come from the
// plugin, so the sliders always match its clamps.
//
// Texts written here are translated with `@tr` (eov compiles the window with
// the plugin's catalogs); texts pushed by the plugin arrive translated.

import { ComboBox, Palette, ScrollView } from "std-widgets.slint";

export struct MappingRow {
    control-key: string,
    control-label: string,
    current-index: int,
    // The text shown for the current choice (pushed, not derived).
    current-label: string,
    axis-control: bool,
}

export struct TuningRow {
    key: string,
    label: string,
    value: float,
    text: string,
    min: float,
    max: float,
    default-value: float,
}

global Theme {
    out property <color> window: #08111d;
    out property <color> card: #0f1726;
    out property <color> card-border: #ffffff10;
    out property <color> field: #0a101b;
    out property <color> field-border: #1f3149;
    out property <color> focus: #5bb2ff;
    out property <color> text: #f5f7fb;
    out property <color> label: #d7e2f3;
    out property <color> muted: #97a3ba;
    out property <color> faint: #5d6d85;
    out property <color> accent: #4d9fff;
    out property <color> track: #18283d;
}

// The writing direction of the interface, which eov sets through the
// window's `eov-rtl`. Arabic, Persian and Hebrew are written from right to
// left: text starts at the right edge there. Sliders, step buttons and the
// controller's directions are physical and are not mirrored.
global Direction {
    in property <bool> rtl;
    out property <TextHorizontalAlignment> start: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
}

// The language of the interface beyond its texts and direction, from the
// panel's `eov-language` (a tag such as "pt-BR").
global Script {
    in property <string> language;
    /// The size for small text (`font-size: Script.text-size(11px)`): at
    /// least 12 px in Hindi, other languages keep `size`. Below 12 px eov's
    /// GPU renderer draws Devanagari with overlapping and missing pieces at
    /// a scale factor of 1.
    public pure function text-size(size: length) -> length {
        return root.language == "hi" ? max(size, 12px) : size;
    }
}

// Slint's ComboBox draws its text at the left in every language. In
// right-to-left languages the window uses this one instead: the same box
// and behaviour (click or Return opens the list, arrow keys and the wheel
// step through it, Escape closes it), with the text at the start of the
// line. The arrow stays at the right: layouts are not mirrored.
component RtlComboBox {
    in property <[string]> model;
    in property <bool> enabled: true;
    in-out property <int> current-index: 0;
    in-out property <string> current-value: root.model[root.current-index];
    out property <bool> has-focus: (focus.has-focus || root.popup-has-focus) && root.enabled;
    callback selected(string);

    private property <bool> popup-has-focus;
    // As Slint's (Fluent) list: 40 px rows, opened over the box.
    private property <length> item-height: 40px;
    private property <int> visible-items: min(6, root.model.length);

    min-width: max(160px, layout.min-width);
    min-height: max(32px, layout.min-height);
    horizontal-stretch: 1;
    vertical-stretch: 0;
    forward-focus: focus;
    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.popup-has-focus;
    accessible-value: root.current-value;
    accessible-action-expand => { popup.show(); }

    function select(index: int) {
        if !root.enabled || index < 0 || index >= root.model.length {
            return;
        }
        root.current-index = index;
        root.current-value = root.model[index];
        root.selected(root.current-value);
    }

    function step(event: KeyEvent) -> EventResult {
        if event.text == Key.UpArrow {
            root.select(max(root.current-index - 1, 0));
            return accept;
        }
        if event.text == Key.DownArrow {
            root.select(min(root.current-index + 1, root.model.length - 1));
            return accept;
        }
        return reject;
    }

    // Shades close to Slint's box in the window's dark scheme: a faint
    // edge, a clearer one and a fainter fill when disabled.
    Rectangle {
        border-radius: 4px;
        border-width: 1px;
        border-color: root.has-focus ? Palette.foreground : root.enabled ? Palette.border.transparentize(0.6) : Palette.border.transparentize(0.15);
        background: root.enabled ? Palette.control-background : Palette.control-background.transparentize(0.35);

        layout := HorizontalLayout {
            padding-left: 11px;
            padding-right: 11px;
            spacing: 8px;

            Text {
                horizontal-stretch: 1;
                horizontal-alignment: Direction.start;
                vertical-alignment: center;
                color: root.enabled ? Palette.control-foreground : Palette.control-foreground.transparentize(0.55);
                text: root.current-value;
                overflow: elide;
                accessible-role: none;
            }

            // The arrow, centred without limiting the box's height.
            Rectangle {
                width: 12px;

                Path {
                    x: 0px;
                    y: (parent.height - self.height) / 2;
                    width: 12px;
                    height: 7px;
                    viewbox-width: 12;
                    viewbox-height: 7;
                    commands: "M 0.5 0.5 L 6 6 L 11.5 0.5";
                    stroke: Palette.control-foreground.transparentize(root.enabled ? 0.25 : 0.6);
                    stroke-width: 1px;
                    fill: transparent;
                    accessible-role: none;
                }
            }
        }
    }

    focus := FocusScope {
        enabled: root.enabled;
        // The list closed and gave the focus back.
        changed has-focus => {
            if self.has-focus {
                root.popup-has-focus = false;
            }
        }
        key-pressed(event) => {
            if event.text == Key.Return {
                popup.show();
                return accept;
            }
            return root.step(event);
        }

        TouchArea {
            enabled: root.enabled;
            clicked => {
                focus.focus();
                popup.show();
            }
            scroll-event(event) => {
                if !root.has-focus {
                    return reject;
                }
                if event.delta-y < -2px {
                    root.select(min(root.current-index + 1, root.model.length - 1));
                    return accept;
                }
                if event.delta-y > 2px {
                    root.select(max(root.current-index - 1, 0));
                    return accept;
                }
                return reject;
            }
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: -4px;
        width: root.width;
        height: root.visible-items * root.item-height + 8px;
        close-policy: close-on-click-outside;
        forward-focus: list-focus;

        list-focus := FocusScope {
            // In the focus event itself, as Slint's box does: a change
            // handler would run later, and has-focus would be false for a
            // moment after the list took the focus from the box.
            focus-changed-event => {
                root.popup-has-focus = self.has-focus;
            }
            key-pressed(event) => {
                if event.text == Key.Return || event.text == Key.Escape {
                    popup.close();
                    return accept;
                }
                return root.step(event);
            }

            Rectangle {
                border-radius: 6px;
                border-width: 1px;
                border-color: Palette.border;
                background: Palette.alternate-background;
                drop-shadow-blur: 12px;
                drop-shadow-offset-y: 6px;
                drop-shadow-color: #00000080;

                ScrollView {
                    x: 4px;
                    y: 4px;
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                    content-y: -max(0, root.current-index - root.visible-items + 1) * root.item-height;

                    VerticalLayout {
                        alignment: start;

                        for value[index] in root.model: Rectangle {
                            height: root.item-height;
                            border-radius: 4px;
                            background: index == root.current-index || item-touch.has-hover ? Palette.foreground.transparentize(0.92) : transparent;
                            accessible-role: list-item;
                            accessible-label: value;
                            accessible-item-selectable: true;
                            accessible-item-selected: index == root.current-index;
                            accessible-item-index: index;

                            if index == root.current-index: Rectangle {
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                                width: 3px;
                                height: 16px;
                                border-radius: 1.5px;
                                background: Palette.accent-background;
                            }

                            // Clear of the scroll bar at the right.
                            Text {
                                x: 12px;
                                width: parent.width - 32px;
                                height: parent.height;
                                text: value;
                                color: Palette.control-foreground;
                                horizontal-alignment: Direction.start;
                                vertical-alignment: center;
                                overflow: elide;
                                accessible-role: none;
                            }

                            item-touch := TouchArea {
                                clicked => {
                                    root.select(index);
                                    popup.close();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// The window's combo boxes: Slint's in left-to-right languages, RtlComboBox
// in right-to-left ones. Both always exist; the other direction's box is
// hidden and disabled, so it never takes the focus.
component Choice inherits Rectangle {
    in property <[string]> model;
    in property <bool> enabled: true;
    in-out property <int> current-index;
    in-out property <string> current-value;
    // The box or its list has the keyboard focus. Bound to the box, not
    // copied in a change handler: a copy would come a round of handlers
    // late, and the window would report itself inactive for a moment when a
    // box takes the focus from it.
    out property <bool> has-focus: root.rtl ? rtl-box.has-focus : ltr-box.has-focus;
    callback selected(int);

    private property <bool> rtl: Direction.rtl;

    // Slint's box gives the choice its size in both directions: the two
    // boxes measure alike.
    HorizontalLayout {
        ltr-box := ComboBox {
            visible: !root.rtl;
            enabled: root.enabled && !root.rtl;
            model: root.model;
            current-index <=> root.current-index;
            current-value <=> root.current-value;
            selected => { root.selected(self.current-index); }
        }
    }

    // Over Slint's box.
    rtl-box := RtlComboBox {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        visible: root.rtl;
        enabled: root.enabled && root.rtl;
        model: root.model;
        current-index <=> root.current-index;
        current-value <=> root.current-value;
        selected => { root.selected(self.current-index); }
    }
}

component Card inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;

    background: Theme.card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.card-border;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        Text {
            text: root.title;
            color: Theme.text;
            font-size: 14px;
            font-weight: 700;
            horizontal-alignment: Direction.start;
        }

        if root.subtitle != "": Text {
            text: root.subtitle;
            color: Theme.muted;
            font-size: Script.text-size(11px);
            wrap: word-wrap;
            horizontal-alignment: Direction.start;
        }

        @children
    }
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <color> base-color: #1f4d84;
    in property <color> hover-color: #2562a8;
    // The width the text needs, padding included.
    out property <length> text-width: label.preferred-width + 16px;
    callback clicked();

    // As wide as its text: a long translation widens the button instead of
    // being cut.
    min-width: max(64px, root.text-width);
    height: 30px;
    border-radius: 8px;
    background: !root.enabled ? #1b2433 : touch.pressed ? root.base-color.darker(0.15) : touch.has-hover ? root.hover-color : root.base-color;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.enabled ? white : #6b7a90;
        font-size: Script.text-size(11px);
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ToggleChip inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    callback toggled(bool);

    width: 72px;
    height: 30px;
    border-radius: 15px;
    background: root.checked ? #1d6fd1 : #293443;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggled(!root.checked); }
    animate background { duration: 120ms; }

    TouchArea {
        clicked => { root.toggled(!root.checked); }
    }

    Rectangle {
        width: 24px;
        height: 24px;
        y: 3px;
        x: root.checked ? 45px : 3px;
        border-radius: 12px;
        background: white;
        animate x { duration: 120ms; }
    }

    // All the room beside the knob, centred where the text always was.
    Text {
        x: root.checked ? 6px : 26px;
        y: 0px;
        width: 40px;
        height: parent.height;
        // Translators: the state of a small switch; keep it very short
        text: root.checked ? @tr("On") : @tr("Off");
        color: white;
        font-size: Script.text-size(10px);
        font-weight: 700;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component StepButton inherits Rectangle {
    in property <string> text;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: touch.pressed ? #23395a : touch.has-hover ? #1b2c45 : #121d2e;
    border-width: 1px;
    border-color: #24364d;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: Theme.label;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A slider with step buttons. The value comes from `setting`; drags and steps are
// reported to the plugin, which clamps them and pushes the stored value back.
component TuningField inherits Rectangle {
    in property <TuningRow> setting;
    in property <bool> enabled: true;
    // The labels' column, shared by the rows so that the sliders line up.
    in property <length> label-width: 118px;
    callback changed(string, float);
    callback step(string, int);
    callback reset(string);

    private property <float> span: max(root.setting.max - root.setting.min, 0.001);
    private property <float> fraction: max(0, min(1, (root.setting.value - root.setting.min) / root.span));

    height: 34px;
    // No stretch, as when its row still sized it.
    vertical-stretch: 0;
    opacity: root.enabled ? 1 : 0.45;

    // Placed rather than sizing the row: the labels' column follows the
    // window's width, which must not depend on it.
    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        spacing: 8px;

        Text {
            width: root.label-width;
            text: root.setting.label;
            color: Theme.label;
            font-size: Script.text-size(11px);
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: Direction.start;
            // Only a narrow window makes the column narrower than a label.
            wrap: word-wrap;
            overflow: elide;
        }

        track-area := Rectangle {
            horizontal-stretch: 1;
            min-width: 60px;
            property <length> inset: 7px;
            property <length> track-width: max(self.width - 2 * self.inset, 1px);
            accessible-role: slider;
            accessible-label: root.setting.label;
            accessible-value: root.setting.text;
            accessible-value-minimum: root.setting.min;
            accessible-value-maximum: root.setting.max;
            accessible-enabled: root.enabled;
            accessible-action-increment => { root.step(root.setting.key, 1); }
            accessible-action-decrement => { root.step(root.setting.key, -1); }

            Rectangle {
                x: track-area.inset;
                y: (parent.height - 4px) / 2;
                width: track-area.track-width;
                height: 4px;
                border-radius: 2px;
                background: Theme.track;

                Rectangle {
                    x: 0px;
                    width: root.fraction * parent.width;
                    height: parent.height;
                    border-radius: parent.border-radius;
                    background: Theme.accent;
                }
            }

            // The knob stays inside the track (GPD-8).
            Rectangle {
                x: track-area.inset + root.fraction * track-area.track-width - 7px;
                y: (parent.height - 14px) / 2;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: #f8fbff;
                border-width: 1px;
                border-color: Theme.accent;
            }

            touch := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;

                function report() {
                    root.changed(
                        root.setting.key,
                        root.setting.min + max(0, min(1, (self.mouse-x - track-area.inset) / track-area.track-width)) * root.span);
                }

                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        self.report();
                    }
                }
                moved => { self.report(); }
                double-clicked => { root.reset(root.setting.key); }
            }
        }

        VerticalLayout {
            alignment: center;

            StepButton {
                text: "−";
                // Translators: for screen readers; {} is a setting, such as Pan Speed
                label: @tr("Decrease {}", root.setting.label);
                enabled: root.enabled;
                clicked => { root.step(root.setting.key, -1); }
            }
        }

        Text {
            width: 38px;
            text: root.setting.text;
            color: #edf3ff;
            font-size: Script.text-size(11px);
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;

            StepButton {
                text: "+";
                // Translators: for screen readers; {} is a setting, such as Pan Speed
                label: @tr("Increase {}", root.setting.label);
                enabled: root.enabled;
                clicked => { root.step(root.setting.key, 1); }
            }
        }
    }
}

component HeaderCard inherits Rectangle {
    in property <bool> enabled;
    in property <string> status;
    in property <int> tone;
    callback toggled(bool);

    border-radius: 16px;
    // Solid rather than a gradient: not every Slint renderer clips gradients
    // to rounded corners.
    background: #134a87;
    border-width: 1px;
    border-color: #ffffff20;

    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        Text {
            text: @tr("Gamepad Control");
            color: white;
            font-size: 18px;
            font-weight: 800;
            horizontal-alignment: Direction.start;
        }

        Text {
            text: @tr("Pan, zoom and move between panes, tabs and series items with a game controller. Input only acts while eov has focus.");
            color: #d8e6ff;
            font-size: Script.text-size(11px);
            wrap: word-wrap;
            horizontal-alignment: Direction.start;
        }

        HorizontalLayout {
            spacing: 10px;

            ToggleChip {
                checked: root.enabled;
                // Translators: the name of the on/off switch, read out by screen readers
                label: @tr("Gamepad input");
                toggled(value) => { root.toggled(value); }
            }

            VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.tone == 1 ? #4cc38a : root.tone == 2 ? #f0b44c : root.tone == 3 ? #ff7a7a : #9fb3cf;
                }
            }

            Text {
                horizontal-stretch: 1;
                text: root.status;
                color: #eff6ff;
                font-size: Script.text-size(11px);
                vertical-alignment: center;
                horizontal-alignment: Direction.start;
                wrap: word-wrap;
            }
        }
    }
}

component DeviceCard inherits Card {
    in property <[string]> options;
    in-out property <int> selected-index;
    in-out property <string> selected-label;
    in property <string> note;
    out property <bool> editing: combo.has-focus;
    callback selected(int);
    callback editing-changed(bool);

    // Translators: the title of the section where the game controller is chosen
    title: @tr("Device");
    subtitle: @tr("Choose the controller that drives eov.");
    changed editing => { root.editing-changed(self.editing); }

    combo := Choice {
        model: root.options;
        current-index <=> root.selected-index;
        // The shown text is pushed too: the combo box does not re-read its
        // model when rows are patched in place.
        current-value <=> root.selected-label;
        enabled: root.options.length > 1;
        selected => { root.selected(self.current-index); }
    }

    if root.note != "": Text {
        text: root.note;
        color: Theme.muted;
        font-size: Script.text-size(10px);
        wrap: word-wrap;
        horizontal-alignment: Direction.start;
    }
}

component ProfileCard inherits Card {
    in property <[string]> options;
    in-out property <int> selected-index;
    in-out property <string> selected-label;
    in property <string> note;
    in-out property <string> name;
    out property <bool> editing: name-input.has-focus || combo.has-focus;
    callback selected(int);
    callback save-as(string);
    callback new-profile(string);
    callback import-profile();
    callback export-profile();
    callback delete-profile();
    callback editing-changed(bool);

    // Translators: a profile is a saved set of gamepad settings
    title: @tr("Profiles");
    subtitle: root.note;
    changed editing => { root.editing-changed(self.editing); }

    combo := Choice {
        model: root.options;
        current-index <=> root.selected-index;
        current-value <=> root.selected-label;
        enabled: root.options.length > 1;
        selected => { root.selected(self.current-index); }
    }

    HorizontalLayout {
        spacing: 8px;

        Rectangle {
            horizontal-stretch: 1;
            height: 30px;
            border-radius: 8px;
            background: Theme.field;
            border-width: 1px;
            border-color: name-input.has-focus ? Theme.focus : Theme.field-border;

            name-input := TextInput {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                text <=> root.name;
                color: #edf3ff;
                font-size: Script.text-size(11px);
                vertical-alignment: center;
                horizontal-alignment: Direction.start;
                single-line: true;
                accessible-label: @tr("Profile name");
                accepted => { root.save-as(self.text); }
            }

            if root.name == "": Text {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                // Translators: placeholder of the empty name field
                text: @tr("Name for a new profile");
                color: Theme.faint;
                font-size: Script.text-size(11px);
                vertical-alignment: center;
                horizontal-alignment: Direction.start;
            }
        }

        ActionButton {
            // 84 px, or what a longer text needs.
            preferred-width: 84px;
            horizontal-stretch: 0;
            // Translators: saves the settings as a profile with the name typed
            text: @tr("Save As");
            clicked => { root.save-as(root.name); }
        }
    }

    // The four buttons are equally wide, as wide as the longest text needs.
    // They share a row while they fit in the card (padding 12 px), and take
    // two rows in a narrow window.
    private property <length> button-width: max(64px, new-button.text-width, import-button.text-width, export-button.text-width, delete-button.text-width);
    private property <bool> two-rows: 4 * root.button-width + 3 * 8px > root.width - 24px;

    // Placed rather than sizing the card, whose width decides the rows.
    Rectangle {
        height: buttons.preferred-height;
        // No stretch, as when the buttons' row still sized the card.
        vertical-stretch: 0;

        buttons := GridLayout {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            spacing: 8px;

            new-button := ActionButton {
                row: 0;
                col: 0;
                min-width: root.button-width;
                horizontal-stretch: 1;
                // Translators: saves the default settings as a new profile
                text: @tr("New");
                clicked => { root.new-profile(root.name); }
            }

            import-button := ActionButton {
                row: 0;
                col: 1;
                min-width: root.button-width;
                horizontal-stretch: 1;
                // Translators: imports a profile from a file
                text: @tr("Import");
                base-color: #1e5678;
                hover-color: #29719d;
                clicked => { root.import-profile(); }
            }

            export-button := ActionButton {
                row: root.two-rows ? 1 : 0;
                col: root.two-rows ? 0 : 2;
                min-width: root.button-width;
                horizontal-stretch: 1;
                // Translators: exports the settings to a profile file
                text: @tr("Export");
                base-color: #1e5678;
                hover-color: #29719d;
                clicked => { root.export-profile(); }
            }

            delete-button := ActionButton {
                row: root.two-rows ? 1 : 0;
                col: root.two-rows ? 1 : 3;
                min-width: root.button-width;
                horizontal-stretch: 1;
                // Translators: deletes the selected profile
                text: @tr("Delete");
                // Entry 0 is "No profile".
                enabled: root.selected-index > 0;
                base-color: #65404a;
                hover-color: #7f4c59;
                clicked => { root.delete-profile(); }
            }
        }
    }
}

component MappingList inherits Rectangle {
    in property <string> heading;
    in property <[MappingRow]> rows;
    in property <[string]> options;
    // The controls' column, shared by both lists.
    in property <length> label-width: 122px;
    callback selected(string, int);
    // A row's combo box gained (true) or lost (false) the keyboard focus.
    callback focus-moved(bool);

    VerticalLayout {
        spacing: 6px;

        Text {
            text: root.heading;
            color: #9eb0ca;
            font-size: Script.text-size(10px);
            font-weight: 700;
            horizontal-alignment: Direction.start;
        }

        for row in root.rows: Rectangle {
            height: 44px;
            // No stretch, as when its row still sized it.
            vertical-stretch: 0;
            border-radius: 10px;
            background: Theme.field;
            border-width: 1px;
            border-color: #1c2d43;

            // Placed rather than sizing the row: the labels' column follows
            // the window's width, which must not depend on it.
            HorizontalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                padding-left: 10px;
                padding-right: 8px;
                spacing: 10px;

                Text {
                    width: root.label-width;
                    text: row.control-label;
                    color: #f2f6ff;
                    font-size: Script.text-size(11px);
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-alignment: Direction.start;
                    wrap: word-wrap;
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;

                    Choice {
                        model: root.options;
                        // Two-way, so mappings pushed later (e.g. a loaded
                        // profile) still show after the user picked one.
                        current-index <=> row.current-index;
                        current-value <=> row.current-label;
                        changed has-focus => { root.focus-moved(self.has-focus); }
                        selected => { root.selected(row.control-key, self.current-index); }
                    }
                }
            }
        }
    }
}

export component GamepadWindow inherits Window {
    // Set by eov: the interface is written from right to left.
    in property <bool> eov-rtl <=> Direction.rtl;
    // Set by eov: the language of the interface (see Script).
    in property <string> eov-language <=> Script.language;
    in property <bool> controller-enabled: true;
    // The texts below are placeholders: the plugin pushes every property,
    // translated, before the window is shown.
    in property <string> status-text: "Starting…";
    in property <int> status-tone: 0;
    in property <[string]> device-options: ["All controllers"];
    in-out property <int> selected-device-index: 0;
    in-out property <string> selected-device-label: "All controllers";
    in property <string> device-note: "";
    in property <[string]> profile-options: ["No profile"];
    in-out property <int> selected-profile-index: 0;
    in-out property <string> selected-profile-label: "No profile";
    in property <string> profile-note: "";
    in-out property <string> profile-name: "";
    in property <[TuningRow]> tuning-rows: [];
    in property <TuningRow> pointer-row;
    in property <bool> pointer-control: false;
    in property <string> pointer-note: "";
    in property <[string]> axis-action-options: [];
    in property <[string]> button-action-options: [];
    in property <[MappingRow]> axis-mappings: [];
    in property <[MappingRow]> button-mappings: [];

    callback enabled-toggled(bool);
    callback device-selected(int);
    callback profile-selected(int);
    callback save-profile-as(string);
    callback new-profile(string);
    callback import-profile();
    callback export-profile();
    callback delete-profile();
    callback tuning-changed(string, float);
    callback tuning-step(string, int);
    callback tuning-reset(string);
    callback pointer-control-toggled(bool);
    callback mapping-selected(string, int);
    // Whether this window is the active one, so the controller keeps working
    // while it has focus. Conservative: it turns on only after the window was
    // activated or used, and off whenever it may not be active.
    callback window-active-changed(bool);

    // Translators: the title of the gamepad settings window
    title: @tr("Gamepad");
    background: Theme.window;
    min-width: 380px;
    min-height: 360px;
    preferred-width: 860px;
    preferred-height: 760px;
    forward-focus: focus-root;
    // The window is dark whatever the desktop's colour scheme.
    init => { Palette.color-scheme = ColorScheme.dark; }

    // Activity evidence:
    // - scope-active: the root focus scope has the focus, and gained it
    //   through window activation, a click or Tab (not programmatically);
    // - armed: an editor (name field, combo box) took the focus from the
    //   active window; it stays armed while focus moves between editors.
    // Input reaching an inactive window (a background click, assistive
    // technology) therefore never makes the window active.
    private property <bool> scope-active;
    private property <bool> armed;
    private property <bool> device-editing;
    private property <bool> profile-editing;
    private property <int> mapping-focus;
    private property <bool> editing: root.device-editing || root.profile-editing || root.mapping-focus > 0;
    private property <bool> window-active: root.scope-active || (root.editing && root.armed);
    changed window-active => { root.window-active-changed(self.window-active); }
    // No editor has the focus any more (the window was deactivated, or the
    // user clicked elsewhere): disarm and give the focus back to the root
    // scope, so that the next activation reaches it.
    changed editing => { settle.running = !self.editing; }

    // The labels' columns are as wide as their widest label (the English
    // widths at least), so long translations are not cut and the rows still
    // line up. Only a window too narrow for them wraps the labels: a tuning
    // row keeps 182 px for its slider, step buttons and value, a mapping row
    // 188 px for its padding and combo box.
    private property <length> card-row-width: content.width - 24px;
    private property <length> tuning-label-width: min(max(118px, tuning-labels.preferred-width), max(118px, root.card-row-width - 182px));
    private property <length> mapping-label-width: min(max(122px, mapping-labels.preferred-width), max(122px, root.card-row-width - 188px));

    // Measure the labels; outside the window's layout, never drawn.
    tuning-labels := VerticalLayout {
        x: 0px;
        y: 0px;

        for row in root.tuning-rows: Text {
            visible: false;
            accessible-role: none;
            text: row.label;
            font-size: Script.text-size(11px);
            font-weight: 700;
        }

        Text {
            visible: false;
            accessible-role: none;
            text: root.pointer-row.label;
            font-size: Script.text-size(11px);
            font-weight: 700;
        }
    }

    mapping-labels := VerticalLayout {
        x: 0px;
        y: 0px;

        for row in root.axis-mappings: Text {
            visible: false;
            accessible-role: none;
            text: row.control-label;
            font-size: Script.text-size(11px);
            font-weight: 700;
        }

        for row in root.button-mappings: Text {
            visible: false;
            accessible-role: none;
            text: row.control-label;
            font-size: Script.text-size(11px);
            font-weight: 700;
        }
    }

    settle := Timer {
        interval: 150ms;
        running: false;
        triggered => {
            self.running = false;
            if !root.editing {
                root.armed = false;
                focus-root.focus();
            }
        }
    }

    focus-root := FocusScope {
        width: 100%;
        height: 100%;

        focus-gained(reason) => {
            // Programmatic focus (window creation, `settle`) proves nothing.
            if reason == FocusReason.window-activation || reason == FocusReason.pointer-click || reason == FocusReason.tab-navigation {
                root.scope-active = true;
            }
        }
        focus-lost(reason) => {
            // Handing the focus to an editor of the active window (combo
            // boxes take it programmatically when clicked). An inactive
            // window never arms: scope-active is false there.
            if root.scope-active && reason != FocusReason.window-activation {
                root.armed = true;
            }
            root.scope-active = false;
        }

        Rectangle {
            background: @linear-gradient(180deg, #11203a 0%, #08111d 30%, #08111d 100%);
        }

        Flickable {
            content-height: content.preferred-height + 28px;
            content-width: self.width;
            interactive: content.preferred-height + 28px > self.height;

            content := VerticalLayout {
                width: min(parent.width - 28px, 800px);
                x: (parent.width - self.width) / 2;
                y: 14px;
                spacing: 12px;

                HeaderCard {
                    enabled: root.controller-enabled;
                    status: root.status-text;
                    tone: root.status-tone;
                    toggled(value) => { root.enabled-toggled(value); }
                }

                DeviceCard {
                    options: root.device-options;
                    selected-index <=> root.selected-device-index;
                    selected-label <=> root.selected-device-label;
                    note: root.device-note;
                    selected(index) => { root.device-selected(index); }
                    editing-changed(editing) => { root.device-editing = editing; }
                }

                ProfileCard {
                    options: root.profile-options;
                    selected-index <=> root.selected-profile-index;
                    selected-label <=> root.selected-profile-label;
                    note: root.profile-note;
                    name <=> root.profile-name;
                    selected(index) => { root.profile-selected(index); }
                    save-as(name) => { root.save-profile-as(name); }
                    new-profile(name) => { root.new-profile(name); }
                    import-profile => { root.import-profile(); }
                    export-profile => { root.export-profile(); }
                    delete-profile => { root.delete-profile(); }
                    editing-changed(editing) => { root.profile-editing = editing; }
                }

                Card {
                    // Translators: the section with dead zones, speeds and response curve
                    title: @tr("Tuning");
                    subtitle: @tr("Dead zones ignore stick drift. Speeds scale panning and zooming, and a higher response curve gives finer control near the centre. Double-click a slider to reset it.");

                    for row in root.tuning-rows: TuningField {
                        setting: row;
                        label-width: root.tuning-label-width;
                        changed(key, value) => { root.tuning-changed(key, value); }
                        step(key, direction) => { root.tuning-step(key, direction); }
                        reset(key) => { root.tuning-reset(key); }
                    }
                }

                Card {
                    // Translators: the mouse pointer of the system, which sticks can move
                    title: @tr("System Pointer");

                    HorizontalLayout {
                        spacing: 10px;

                        VerticalLayout {
                            alignment: start;

                            ToggleChip {
                                checked: root.pointer-control;
                                // Translators: the name of the on/off switch, read out by screen readers
                                label: @tr("System pointer control");
                                toggled(value) => { root.pointer-control-toggled(value); }
                            }
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: root.pointer-note;
                            color: Theme.muted;
                            font-size: Script.text-size(11px);
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-alignment: Direction.start;
                        }
                    }

                    TuningField {
                        setting: root.pointer-row;
                        enabled: root.pointer-control;
                        label-width: root.tuning-label-width;
                        changed(key, value) => { root.tuning-changed(key, value); }
                        step(key, direction) => { root.tuning-step(key, direction); }
                        reset(key) => { root.tuning-reset(key); }
                    }
                }

                Card {
                    // Translators: the section that assigns actions to the controls
                    title: @tr("Mappings");
                    // Translators: Start and Select are names printed on controller buttons
                    subtitle: @tr("Defaults: the left stick pans, the right stick and the triggers zoom, the D-pad switches panes and tabs, the shoulder buttons step through the series, Start pauses and Select shows this window.");

                    MappingList {
                        // Translators: a heading (in capitals in English: use your own style)
                        heading: @tr("STICKS AND TRIGGERS");
                        label-width: root.mapping-label-width;
                        rows: root.axis-mappings;
                        options: root.axis-action-options;
                        selected(key, index) => { root.mapping-selected(key, index); }
                        focus-moved(focused) => { root.mapping-focus = max(0, root.mapping-focus + (focused ? 1 : -1)); }
                    }

                    MappingList {
                        // Translators: a heading (in capitals in English: use your own style)
                        heading: @tr("BUTTONS");
                        label-width: root.mapping-label-width;
                        rows: root.button-mappings;
                        options: root.button-action-options;
                        selected(key, index) => { root.mapping-selected(key, index); }
                        focus-moved(focused) => { root.mapping-focus = max(0, root.mapping-focus + (focused ? 1 : -1)); }
                    }
                }
            }
        }
    }
}
