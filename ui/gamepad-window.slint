// The gamepad settings window: a plugin surface of kind Window.
//
// Every value is pushed by the plugin (`Surface::set_many`); callbacks go back
// to it (`Plugin::ui_callback`). Ranges, labels and defaults come from the
// plugin, so the sliders always match its clamps.

import { ComboBox, Palette } from "std-widgets.slint";

export struct MappingRow {
    control-key: string,
    control-label: string,
    current-index: int,
    axis-control: bool,
}

export struct TuningRow {
    key: string,
    label: string,
    value: float,
    text: string,
    min: float,
    max: float,
    default-value: float,
}

global Theme {
    out property <color> window: #08111d;
    out property <color> card: #0f1726;
    out property <color> card-border: #ffffff10;
    out property <color> field: #0a101b;
    out property <color> field-border: #1f3149;
    out property <color> focus: #5bb2ff;
    out property <color> text: #f5f7fb;
    out property <color> label: #d7e2f3;
    out property <color> muted: #97a3ba;
    out property <color> faint: #5d6d85;
    out property <color> accent: #4d9fff;
    out property <color> track: #18283d;
}

component Card inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;

    background: Theme.card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.card-border;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        Text {
            text: root.title;
            color: Theme.text;
            font-size: 14px;
            font-weight: 700;
        }

        if root.subtitle != "": Text {
            text: root.subtitle;
            color: Theme.muted;
            font-size: 11px;
            wrap: word-wrap;
        }

        @children
    }
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <color> base-color: #1f4d84;
    in property <color> hover-color: #2562a8;
    callback clicked();

    min-width: 64px;
    height: 30px;
    border-radius: 8px;
    background: !root.enabled ? #1b2433 : touch.pressed ? root.base-color.darker(0.15) : touch.has-hover ? root.hover-color : root.base-color;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.enabled ? white : #6b7a90;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ToggleChip inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    callback toggled(bool);

    width: 72px;
    height: 30px;
    border-radius: 15px;
    background: root.checked ? #1d6fd1 : #293443;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggled(!root.checked); }
    animate background { duration: 120ms; }

    TouchArea {
        clicked => { root.toggled(!root.checked); }
    }

    Rectangle {
        width: 24px;
        height: 24px;
        y: 3px;
        x: root.checked ? 45px : 3px;
        border-radius: 12px;
        background: white;
        animate x { duration: 120ms; }
    }

    Text {
        x: root.checked ? 10px : 30px;
        y: 0px;
        width: 32px;
        height: parent.height;
        text: root.checked ? "On" : "Off";
        color: white;
        font-size: 10px;
        font-weight: 700;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component StepButton inherits Rectangle {
    in property <string> text;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: touch.pressed ? #23395a : touch.has-hover ? #1b2c45 : #121d2e;
    border-width: 1px;
    border-color: #24364d;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: Theme.label;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A slider with step buttons. The value comes from `setting`; drags and steps are
// reported to the plugin, which clamps them and pushes the stored value back.
component TuningField inherits Rectangle {
    in property <TuningRow> setting;
    in property <bool> enabled: true;
    callback changed(string, float);
    callback step(string, int);
    callback reset(string);

    private property <float> span: max(root.setting.max - root.setting.min, 0.001);
    private property <float> fraction: max(0, min(1, (root.setting.value - root.setting.min) / root.span));

    height: 34px;
    opacity: root.enabled ? 1 : 0.45;

    HorizontalLayout {
        spacing: 8px;

        Text {
            width: 118px;
            text: root.setting.label;
            color: Theme.label;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }

        track-area := Rectangle {
            horizontal-stretch: 1;
            min-width: 60px;
            property <length> inset: 7px;
            property <length> track-width: max(self.width - 2 * self.inset, 1px);
            accessible-role: slider;
            accessible-label: root.setting.label;
            accessible-value: root.setting.text;
            accessible-value-minimum: root.setting.min;
            accessible-value-maximum: root.setting.max;
            accessible-enabled: root.enabled;
            accessible-action-increment => { root.step(root.setting.key, 1); }
            accessible-action-decrement => { root.step(root.setting.key, -1); }

            Rectangle {
                x: track-area.inset;
                y: (parent.height - 4px) / 2;
                width: track-area.track-width;
                height: 4px;
                border-radius: 2px;
                background: Theme.track;

                Rectangle {
                    x: 0px;
                    width: root.fraction * parent.width;
                    height: parent.height;
                    border-radius: parent.border-radius;
                    background: Theme.accent;
                }
            }

            // The knob stays inside the track (GPD-8).
            Rectangle {
                x: track-area.inset + root.fraction * track-area.track-width - 7px;
                y: (parent.height - 14px) / 2;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: #f8fbff;
                border-width: 1px;
                border-color: Theme.accent;
            }

            touch := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;

                function report() {
                    root.changed(
                        root.setting.key,
                        root.setting.min + max(0, min(1, (self.mouse-x - track-area.inset) / track-area.track-width)) * root.span);
                }

                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        self.report();
                    }
                }
                moved => { self.report(); }
                double-clicked => { root.reset(root.setting.key); }
            }
        }

        VerticalLayout {
            alignment: center;

            StepButton {
                text: "−";
                label: "Decrease " + root.setting.label;
                enabled: root.enabled;
                clicked => { root.step(root.setting.key, -1); }
            }
        }

        Text {
            width: 38px;
            text: root.setting.text;
            color: #edf3ff;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;

            StepButton {
                text: "+";
                label: "Increase " + root.setting.label;
                enabled: root.enabled;
                clicked => { root.step(root.setting.key, 1); }
            }
        }
    }
}

component HeaderCard inherits Rectangle {
    in property <bool> enabled;
    in property <string> status;
    in property <int> tone;
    callback toggled(bool);

    border-radius: 16px;
    // Solid rather than a gradient: not every Slint renderer clips gradients
    // to rounded corners.
    background: #134a87;
    border-width: 1px;
    border-color: #ffffff20;

    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        Text {
            text: "Gamepad Control";
            color: white;
            font-size: 18px;
            font-weight: 800;
        }

        Text {
            text: "Pan, zoom and move between panes, tabs and series items with a game controller. Input only acts while eov has focus.";
            color: #d8e6ff;
            font-size: 11px;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 10px;

            ToggleChip {
                checked: root.enabled;
                label: "Gamepad input";
                toggled(value) => { root.toggled(value); }
            }

            VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.tone == 1 ? #4cc38a : root.tone == 2 ? #f0b44c : root.tone == 3 ? #ff7a7a : #9fb3cf;
                }
            }

            Text {
                horizontal-stretch: 1;
                text: root.status;
                color: #eff6ff;
                font-size: 11px;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

component DeviceCard inherits Card {
    in property <[string]> options;
    in-out property <int> selected-index;
    in property <string> note;
    out property <bool> editing: combo.has-focus;
    callback selected(int);
    callback editing-changed(bool);
    callback done();

    title: "Device";
    subtitle: "Choose the controller that drives eov.";
    changed editing => { root.editing-changed(self.editing); }

    combo := ComboBox {
        model: root.options;
        current-index <=> root.selected-index;
        enabled: root.options.length > 1;
        selected => {
            root.selected(self.current-index);
            root.done();
        }
    }

    if root.note != "": Text {
        text: root.note;
        color: Theme.muted;
        font-size: 10px;
        wrap: word-wrap;
    }
}

component ProfileCard inherits Card {
    in property <[string]> options;
    in-out property <int> selected-index;
    in property <string> note;
    in-out property <string> name;
    out property <bool> editing: name-input.has-focus || combo.has-focus;
    callback selected(int);
    callback save-as(string);
    callback new-profile(string);
    callback import-profile();
    callback export-profile();
    callback delete-profile();
    callback editing-changed(bool);
    callback done();

    title: "Profiles";
    subtitle: root.note;
    changed editing => { root.editing-changed(self.editing); }

    combo := ComboBox {
        model: root.options;
        current-index <=> root.selected-index;
        enabled: root.options.length > 1;
        selected => {
            root.selected(self.current-index);
            root.done();
        }
    }

    HorizontalLayout {
        spacing: 8px;

        Rectangle {
            horizontal-stretch: 1;
            height: 30px;
            border-radius: 8px;
            background: Theme.field;
            border-width: 1px;
            border-color: name-input.has-focus ? Theme.focus : Theme.field-border;

            name-input := TextInput {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                text <=> root.name;
                color: #edf3ff;
                font-size: 11px;
                vertical-alignment: center;
                single-line: true;
                accessible-label: "Profile name";
                accepted => { root.save-as(self.text); }
            }

            if root.name == "": Text {
                x: 10px;
                height: parent.height;
                text: "Name for a new profile";
                color: Theme.faint;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        ActionButton {
            width: 84px;
            text: "Save As";
            clicked => { root.save-as(root.name); }
        }
    }

    HorizontalLayout {
        spacing: 8px;

        ActionButton {
            horizontal-stretch: 1;
            text: "New";
            clicked => { root.new-profile(root.name); }
        }

        ActionButton {
            horizontal-stretch: 1;
            text: "Import";
            base-color: #1e5678;
            hover-color: #29719d;
            clicked => { root.import-profile(); }
        }

        ActionButton {
            horizontal-stretch: 1;
            text: "Export";
            base-color: #1e5678;
            hover-color: #29719d;
            clicked => { root.export-profile(); }
        }

        ActionButton {
            horizontal-stretch: 1;
            text: "Delete";
            // Entry 0 is "No profile".
            enabled: root.selected-index > 0;
            base-color: #65404a;
            hover-color: #7f4c59;
            clicked => { root.delete-profile(); }
        }
    }
}

component MappingList inherits Rectangle {
    in property <string> heading;
    in property <[MappingRow]> rows;
    in property <[string]> options;
    callback selected(string, int);
    callback done();

    VerticalLayout {
        spacing: 6px;

        Text {
            text: root.heading;
            color: #9eb0ca;
            font-size: 10px;
            font-weight: 700;
        }

        for row in root.rows: Rectangle {
            height: 44px;
            border-radius: 10px;
            background: Theme.field;
            border-width: 1px;
            border-color: #1c2d43;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 8px;
                spacing: 10px;

                Text {
                    width: 122px;
                    text: row.control-label;
                    color: #f2f6ff;
                    font-size: 11px;
                    font-weight: 700;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;

                    ComboBox {
                        model: root.options;
                        // Two-way, so mappings pushed later (e.g. a loaded
                        // profile) still show after the user picked one.
                        current-index <=> row.current-index;
                        selected => {
                            root.selected(row.control-key, self.current-index);
                            root.done();
                        }
                    }
                }
            }
        }
    }
}

export component GamepadWindow inherits Window {
    in property <bool> controller-enabled: true;
    in property <string> status-text: "Starting…";
    in property <int> status-tone: 0;
    in property <[string]> device-options: ["All controllers"];
    in-out property <int> selected-device-index: 0;
    in property <string> device-note: "";
    in property <[string]> profile-options: ["No profile"];
    in-out property <int> selected-profile-index: 0;
    in property <string> profile-note: "";
    in-out property <string> profile-name: "";
    in property <[TuningRow]> tuning-rows: [];
    in property <TuningRow> pointer-row;
    in property <bool> pointer-control: false;
    in property <string> pointer-note: "";
    in property <[string]> axis-action-options: [];
    in property <[string]> button-action-options: [];
    in property <[MappingRow]> axis-mappings: [];
    in property <[MappingRow]> button-mappings: [];

    callback enabled-toggled(bool);
    callback device-selected(int);
    callback profile-selected(int);
    callback save-profile-as(string);
    callback new-profile(string);
    callback import-profile();
    callback export-profile();
    callback delete-profile();
    callback tuning-changed(string, float);
    callback tuning-step(string, int);
    callback tuning-reset(string);
    callback pointer-control-toggled(bool);
    callback mapping-selected(string, int);
    // Whether this window is the active one, so the controller keeps working
    // while it has focus. Conservative: it turns on only after the window was
    // activated or used, and off whenever it may not be active.
    callback window-active-changed(bool);

    title: "Gamepad";
    background: Theme.window;
    min-width: 380px;
    min-height: 360px;
    preferred-width: 860px;
    preferred-height: 760px;
    forward-focus: focus-root;
    // The window is dark whatever the desktop's colour scheme.
    init => { Palette.color-scheme = ColorScheme.dark; }

    private property <bool> scope-active;
    private property <bool> device-editing;
    private property <bool> profile-editing;
    private property <bool> window-active: root.scope-active || root.device-editing || root.profile-editing;
    changed window-active => { root.window-active-changed(self.window-active); }

    // After a menu choice: the user is in this window; take the focus back
    // from the combo box.
    function interacted() {
        root.scope-active = true;
        focus-root.focus();
    }

    focus-root := FocusScope {
        width: 100%;
        height: 100%;

        focus-gained(reason) => {
            // Programmatic focus (window creation) proves nothing.
            if reason == FocusReason.window-activation || reason == FocusReason.pointer-click || reason == FocusReason.tab-navigation {
                root.scope-active = true;
            }
        }
        focus-lost(reason) => { root.scope-active = false; }

        Rectangle {
            background: @linear-gradient(180deg, #11203a 0%, #08111d 30%, #08111d 100%);
        }

        Flickable {
            viewport-height: content.preferred-height + 28px;
            viewport-width: self.width;
            interactive: content.preferred-height + 28px > self.height;

            content := VerticalLayout {
                width: min(parent.width - 28px, 800px);
                x: (parent.width - self.width) / 2;
                y: 14px;
                spacing: 12px;

                HeaderCard {
                    enabled: root.controller-enabled;
                    status: root.status-text;
                    tone: root.status-tone;
                    toggled(value) => { root.enabled-toggled(value); }
                }

                DeviceCard {
                    options: root.device-options;
                    selected-index <=> root.selected-device-index;
                    note: root.device-note;
                    selected(index) => { root.device-selected(index); }
                    editing-changed(editing) => { root.device-editing = editing; }
                    done => { root.interacted(); }
                }

                ProfileCard {
                    options: root.profile-options;
                    selected-index <=> root.selected-profile-index;
                    note: root.profile-note;
                    name <=> root.profile-name;
                    selected(index) => { root.profile-selected(index); }
                    save-as(name) => { root.save-profile-as(name); }
                    new-profile(name) => { root.new-profile(name); }
                    import-profile => { root.import-profile(); }
                    export-profile => { root.export-profile(); }
                    delete-profile => { root.delete-profile(); }
                    editing-changed(editing) => { root.profile-editing = editing; }
                    done => { root.interacted(); }
                }

                Card {
                    title: "Tuning";
                    subtitle: "Dead zones ignore stick drift. Speeds scale panning and zooming, and a higher response curve gives finer control near the centre. Double-click a slider to reset it.";

                    for row in root.tuning-rows: TuningField {
                        setting: row;
                        changed(key, value) => { root.tuning-changed(key, value); }
                        step(key, direction) => { root.tuning-step(key, direction); }
                        reset(key) => { root.tuning-reset(key); }
                    }
                }

                Card {
                    title: "System Pointer";

                    HorizontalLayout {
                        spacing: 10px;

                        VerticalLayout {
                            alignment: start;

                            ToggleChip {
                                checked: root.pointer-control;
                                label: "System pointer control";
                                toggled(value) => { root.pointer-control-toggled(value); }
                            }
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: root.pointer-note;
                            color: Theme.muted;
                            font-size: 11px;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                    }

                    TuningField {
                        setting: root.pointer-row;
                        enabled: root.pointer-control;
                        changed(key, value) => { root.tuning-changed(key, value); }
                        step(key, direction) => { root.tuning-step(key, direction); }
                        reset(key) => { root.tuning-reset(key); }
                    }
                }

                Card {
                    title: "Mappings";
                    subtitle: "Defaults: the left stick pans, the right stick and the triggers zoom, the D-pad switches panes and tabs, the shoulder buttons step through the series, Start pauses and Select shows this window.";

                    MappingList {
                        heading: "STICKS AND TRIGGERS";
                        rows: root.axis-mappings;
                        options: root.axis-action-options;
                        selected(key, index) => { root.mapping-selected(key, index); }
                        done => { root.interacted(); }
                    }

                    MappingList {
                        heading: "BUTTONS";
                        rows: root.button-mappings;
                        options: root.button-action-options;
                        selected(key, index) => { root.mapping-selected(key, index); }
                        done => { root.interacted(); }
                    }
                }
            }
        }
    }
}
